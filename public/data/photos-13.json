iginal":{"value":"Taken on 4 October 2014, 11:04"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":42828050,"title":"File:Juist, Altes Warmbad -- 2014 -- 3632.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Juist%2C_Altes_Warmbad_--_2014_--_3632.jpg/960px-Juist%2C_Altes_Warmbad_--_2014_--_3632.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Juist,_Altes_Warmbad_--_2014_--_3632.jpg","extmetadata":{"ImageDescription":{"value":"Old Warmbad (Kurverwaltung), <a href=\"https://en.wikipedia.org/wiki/Juist\" class=\"extiw\" title=\"en:Juist\">Juist</a>, <a href=\"https://en.wikipedia.org/wiki/Lower_Saxony\" class=\"extiw\" title=\"en:Lower Saxony\">Lower Saxony</a>, Germany"},"DateTimeOriginal":{"value":"Taken on 4 October 2014, 14:23"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":48615973,"title":"File:Jubilee and Munin, Ravens, Tower of London 2016-04-30.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Jubilee_and_Munin%2C_Ravens%2C_Tower_of_London_2016-04-30.jpg/960px-Jubilee_and_Munin%2C_Ravens%2C_Tower_of_London_2016-04-30.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jubilee_and_Munin,_Ravens,_Tower_of_London_2016-04-30.jpg","extmetadata":{"ImageDescription":{"value":"Jubilee and Munin, <a href=\"https://en.wikipedia.org/wiki/Ravens_of_the_Tower_of_London\" class=\"extiw\" title=\"en:Ravens of the Tower of London\">Ravens of the Tower of London</a>. Jubilee (left) was hatched in Somerset in 2012 and wears a gold <a href=\"https://en.wikipedia.org/wiki/Bird_ringing\" class=\"extiw\" title=\"en:Bird ringing\">band</a>. He was given to the Queen on her <a href=\"https://en.wikipedia.org/wiki/Diamond_Jubilee_of_Elizabeth_II\" class=\"extiw\" title=\"en:Diamond Jubilee of Elizabeth II\">Diamond Jubilee</a>. Munin (right) was hatched in North Uist in 1995 and wears a light green band. She is the oldest raven at the tower. Identification confirmed with Chris Skaife, Ravenmaster at the Tower. <span class=\"plainlinks\"><small>(Sources: <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://hrpprodsa.blob.core.windows.net/hrp-prod-container/11164/tolravensleaflet2013.pdf\">[4]</a>, <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://web.archive.org/web/20180627034340/https://www.hrp.org.uk/tower-of-london/explore/the-ravens/\">[5]</a>, <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://www.bbc.co.uk/news/uk-england-somerset-18611229\">[6]</a>)</small></span>"},"DateTimeOriginal":{"value":"2016-04-30 11:43:45"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Colin\" title=\"User:Colin\">Colin</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":73239069,"title":"File:Jukung Pasar Terapung.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Jukung_Pasar_Terapung.jpg/960px-Jukung_Pasar_Terapung.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jukung_Pasar_Terapung.jpg","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Floating_market\" class=\"extiw\" title=\"w:Floating market\">Pasar terapung</a> is a culture of the city of a thousand rivers, <a href=\"https://en.wikipedia.org/wiki/Banjarmasin\" class=\"extiw\" title=\"w:Banjarmasin\">Banjarmasin</a>. The uniqueness of transactions in pasar terapung is a reflection of the culture of the people of Banjar. Until now the pasar terapung Lok Baintan, at Banjar district is still as the main attraction of South Kalimantan's trade and tourism activities"},"DateTimeOriginal":{"value":"2016-11-26 08:10:19"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Fgharis\" title=\"User:Fgharis\">Muhammad Haris</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":77794295,"title":"File:Julia Margaret Cameron MET DP114480 - Restoration.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Julia_Margaret_Cameron_MET_DP114480_-_Restoration.jpg/960px-Julia_Margaret_Cameron_MET_DP114480_-_Restoration.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Julia_Margaret_Cameron_MET_DP114480_-_Restoration.jpg","extmetadata":{"ImageDescription":{"value":"<div class=\"description\">\n<dl><dt>Photograph; Photographs</dt></dl></div>"},"DateTimeOriginal":{"value":"1870<div style=\"display: none;\">date QS:P571,+1870-00-00T00:00:00Z/9</div>"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Henry_Herschel_Hay_Cameron\" class=\"extiw\" title=\"w:en:Henry Herschel Hay Cameron\"><span title=\"British photographer (1852-1911)\">Henry Herschel Hay Cameron</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":83065220,"title":"File:Jules Verne by Étienne Carjat.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Jules_Verne_by_%C3%89tienne_Carjat.jpg/960px-Jules_Verne_by_%C3%89tienne_Carjat.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jules_Verne_by_%C3%89tienne_Carjat.jpg","extmetadata":{"ImageDescription":{"value":"Портрет французького письменника <a href=\"https://uk.wikipedia.org/wiki/%D0%96%D1%83%D0%BB%D1%8C_%D0%92%D0%B5%D1%80%D0%BD\" class=\"extiw\" title=\"uk:Жуль Верн\">Жуля Верна</a>, зроблений <a href=\"https://uk.wikipedia.org/wiki/%D0%95%D1%82%D1%8C%D1%94%D0%BD_%D0%9A%D0%B0%D1%80%D0%B6%D0%B0\" class=\"extiw\" title=\"uk:Етьєн Каржа\">Етьєном Каржа</a> в 1884 році (12,3x8,6 см). Жуль Верн відомий своїми пригодницькими романами з урахуванням технічного прогресу свого часу, він є другим автором у світі за кількістю перекладів."},"DateTimeOriginal":{"value":"Published c. 9 February 1884<sup id=\"cite_ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">[</span>4<span class=\"cite-bracket\">]</span></a></sup>"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:%C3%89tienne_Carjat\" class=\"extiw\" title=\"w:en:Étienne Carjat\"><span title=\"French artist (1828–1906)\">Étienne Carjat</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":90115278,"title":"File:Judasboom (Cercis canadensis 'Forest Pansy'). 15-04-2020. (actm.) 03.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Judasboom_%28Cercis_canadensis_%27Forest_Pansy%27%29._15-04-2020._%28actm.%29_03.jpg/960px-Judasboom_%28Cercis_canadensis_%27Forest_Pansy%27%29._15-04-2020._%28actm.%29_03.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Judasboom_(Cercis_canadensis_%27Forest_Pansy%27)._15-04-2020._(actm.)_03.jpg","extmetadata":{"ImageDescription":{"value":"Eastern redbud (<i> Cercis canadensis </i> 'Forest Pansy') Blooms on the bare wood. Location, Garden Tuinreservaat Jonker Valley."},"DateTimeOriginal":{"v