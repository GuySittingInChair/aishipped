rg/wiki/File:Volc%C3%A1n_de_Ollag%C3%BCe,_Bolivia,_2016-02-03,_DD_80-88_PAN.JPG","extmetadata":{"ImageDescription":{"value":"Volcanic landscape featuring from left to right <a href=\"https://en.wikipedia.org/wiki/Tomasamil\" class=\"extiw\" title=\"en:Tomasamil\">Tomasamil</a> (5,890 m or 19,320 ft), <a href=\"https://en.wikipedia.org/wiki/Cerro_Ca%C3%B1apa\" class=\"extiw\" title=\"en:Cerro Cañapa\">Cañapa</a> (5,882 m or 19,298 ft), <a href=\"https://en.wikipedia.org/wiki/Ollag%C3%BCe\" class=\"extiw\" title=\"en:Ollagüe\">Ollagüe</a> (5,868 m or 19,252 ft) and Aucanquilcha (6,176 m or 20,262 ft), <a href=\"https://en.wikipedia.org/wiki/Andes\" class=\"extiw\" title=\"en:Andes\">Andes</a>, southern Bolivia/northern Chile."},"DateTimeOriginal":{"value":"2016-02-03 14:15:16"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":50203627,"title":"File:Volcanes de lodo, Buzau, Rumanía, 2016-05-29, DD 28.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_28.jpg/960px-Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_28.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Volcanes_de_lodo,_Buzau,_Ruman%C3%ADa,_2016-05-29,_DD_28.jpg","extmetadata":{"ImageDescription":{"value":"The <a href=\"https://en.wikipedia.org/wiki/Berca_Mud_Volcanoes\" class=\"extiw\" title=\"en:Berca Mud Volcanoes\">Berca Mud Volcanoes</a> are a geological and botanical reservation located close to <a href=\"https://en.wikipedia.org/wiki/Berca\" class=\"extiw\" title=\"en:Berca\">Berca</a> in <a href=\"https://en.wikipedia.org/wiki/Buz%C4%83u_County\" class=\"extiw\" title=\"en:Buzău County\">Buzău County</a>, <a href=\"https://en.wikipedia.org/wiki/Romania\" class=\"extiw\" title=\"en:Romania\">Romania</a>. The phenomenon is caused due to gases that erupt from 3,000 metres (9,800 ft) deep towards the surface, through the underground layers of <a href=\"https://en.wikipedia.org/wiki/clay\" class=\"extiw\" title=\"en:clay\">clay</a> and <a href=\"https://en.wikipedia.org/wiki/Aquifer\" class=\"extiw\" title=\"en:Aquifer\">water</a>, they push up underground salty water and mud, so that they overflow through the mouths of the volcanoes, while the gas emerges as bubbles. When the mud arrives at the surface, it dries off, changing the landscape in ways like you can see here."},"DateTimeOriginal":{"value":"2016-05-29 13:52:14"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":50203636,"title":"File:Volcanes de lodo, Buzau, Rumanía, 2016-05-29, DD 33.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_33.jpg/960px-Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_33.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Volcanes_de_lodo,_Buzau,_Ruman%C3%ADa,_2016-05-29,_DD_33.jpg","extmetadata":{"ImageDescription":{"value":"The <a href=\"https://en.wikipedia.org/wiki/Berca_Mud_Volcanoes\" class=\"extiw\" title=\"en:Berca Mud Volcanoes\">Berca Mud Volcanoes</a> are a geological and botanical reservation located close to <a href=\"https://en.wikipedia.org/wiki/Berca\" class=\"extiw\" title=\"en:Berca\">Berca</a> in <a href=\"https://en.wikipedia.org/wiki/Buz%C4%83u_County\" class=\"extiw\" title=\"en:Buzău County\">Buzău County</a>, <a href=\"https://en.wikipedia.org/wiki/Romania\" class=\"extiw\" title=\"en:Romania\">Romania</a>. The phenomenon is caused due to gases that erupt from 3,000 metres (9,800 ft) deep towards the surface, through the underground layers of <a href=\"https://en.wikipedia.org/wiki/clay\" class=\"extiw\" title=\"en:clay\">clay</a> and <a href=\"https://en.wikipedia.org/wiki/Aquifer\" class=\"extiw\" title=\"en:Aquifer\">water</a>, they push up underground salty water and mud, so that they overflow through the mouths of the volcanoes, while the gas emerges as bubbles as you can see in the image."},"DateTimeOriginal":{"value":"2016-05-29 14:01:08"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":50203638,"title":"File:Volcanes de lodo, Buzau, Rumanía, 2016-05-29, DD 34.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_34.jpg/960px-Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_34.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Volcanes_de_lodo,_Buzau,_Ruman%C3%ADa,_2016-05-29,_DD_34.jpg","extmetadata":{"ImageDescription":{"value":"Mud flow out of a <a href=\"https://en.wikipedia.org/wiki/Berca_Mud_Volcanoes\" class=\"extiw\" title=\"en:Berca Mud Volcanoes\">Berca Mud volcano</a>, a geological and botanical reservation located close to <a href=\"https://en.wikipedia.org/wiki/Berca\" class=\"extiw\" title=\"en:Berca\">Berca</a>, <a href=\"https://en.wikipedia.org/wiki/Buz%C4%83u_County\" class=\"extiw\" title=\"en:Buzău County\">Buzău County</a>, <a href=\"https://en.wikipedia.org/wiki/Romania\" class=\"extiw\" title=\"en:Romania\">Romania</a>. The phenomenon is caused due to gases that erupt from 3,000 metres (9,800 ft) deep towards the surface, through the underground layers of <a href=\"https://en.wikipedia.org/wiki/clay\" class=\"extiw\" title=\"en:clay\">clay</a> and <a href=\"https://en.wikipedia.org/wiki/Aquifer\" class=\"extiw\" title=\"en:Aquifer\">water</a>, they push up underground salty water and mud, so that they overflow through the mouths of the volcanoes, while the gas emerges as bubbles. The blur in the middle of the channel is due to a wave of mud that passed every approx. 20 seconds."},"DateTimeOriginal":{"value":"2016-05-29 14:03:29"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":50203651,"title":"File:Volcanes de lodo, Buzau, Rumanía, 2016-05-29, DD 41.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_41.jpg/960px-Volcanes_de_lodo%2C_Buzau%2C_Ruman%C3%ADa%2C_2016-05-29%2C_DD_41.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Volcanes_de_lodo,_Buzau,_Ruman%C3%ADa,_2016-05-29,_DD_41.jpg","extmetadata":{"ImageDescription":{"value":"Detail view of mud flow out of a <a href=\"https://en.wikipedia.org/wiki/Berca_Mud_Volcanoes\" class=\"extiw\" title=\"en:Berca Mud Volcanoes\">Berca Mud volcano</a>, a geological and botanical reservation located close to <a href=\"https://en.wikipedia.org/wiki/Berca\" class=\"extiw\" title=\"en:Berca\">Berca</a>, <a href=\"https://en.wikipedia.org/wiki/Buz%C4%83u_County\" class=\"extiw\" title=\"en:Buzău County\">Buzău County</a>, <a href=\"https://en.wikipedia.org/wiki/Romania\" class=\"extiw\" title=\"en:Romania\">Romania</a>. The phenomenon is caused by gases that erupt from 3,000 metres (9,800 ft) deep towards the surface, through the underground layers of <a href=\"https://en.wikipedia.