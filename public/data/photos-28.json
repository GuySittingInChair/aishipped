,"title":"File:Zeche-Zollverein-Schacht-12-Foerdergeruest-2012.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Zeche-Zollverein-Schacht-12-Foerdergeruest-2012.jpg/960px-Zeche-Zollverein-Schacht-12-Foerdergeruest-2012.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zeche-Zollverein-Schacht-12-Foerdergeruest-2012.jpg","extmetadata":{"ImageDescription":{"value":"Headgear of coal mine industrial complex, shaft 12 of World Heritage Zeche Zollverein in Essen, Germany."},"DateTimeOriginal":{"value":"2012-09-20"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:Michael_D%C3%B6ring&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Michael Döring (page does not exist)\">Michael A. Döring</a>"},"LicenseShortName":{"value":"CC BY-SA 2.0"}}}]},{"pageid":27837830,"title":"File:Zeche Zollverein abends.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Zeche_Zollverein_abends.jpg/960px-Zeche_Zollverein_abends.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zeche_Zollverein_abends.jpg","extmetadata":{"ImageDescription":{"value":"World Heritage Site <i>Zeche Zollverein</i> in <a href=\"https://en.wikipedia.org/wiki/Essen\" class=\"extiw\" title=\"en:Essen\">Essen</a>, <a href=\"https://en.wikipedia.org/wiki/Germany\" class=\"extiw\" title=\"en:Germany\">Germany</a>."},"DateTimeOriginal":{"value":"2013-08-18"},"Artist":{"value":"<b><a href=\"//commons.wikimedia.org/wiki/User:Der_Wolf_im_Wald\" title=\"User:Der Wolf im Wald\">Thomas Wolf</a></b>, <small><a rel=\"nofollow\" class=\"external text\" href=\"http://www.foto-tw.de\">www.foto-tw.de</a></small>"},"LicenseShortName":{"value":"CC BY-SA 3.0 de"}}}]},{"pageid":46324397,"title":"File:Zea mays 'Ottofile giallo Tortonese' MHNT.BOT.2015.34.1.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Zea_mays_%27Ottofile_giallo_Tortonese%27_MHNT.BOT.2015.34.1.jpg/960px-Zea_mays_%27Ottofile_giallo_Tortonese%27_MHNT.BOT.2015.34.1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zea_mays_%27Ottofile_giallo_Tortonese%27_MHNT.BOT.2015.34.1.jpg","extmetadata":{"ImageDescription":{"value":"Zea mays 'Ottofile giallo Tortonese', , seeds"},"DateTimeOriginal":{"value":"12 November 2015"},"Artist":{"value":"<div class=\"fn value\">\n<a href=\"//commons.wikimedia.org/wiki/User:Erc%C3%A9\" title=\"User:Ercé\">Roger Culos</a></div>"},"LicenseShortName":{"value":"CC BY-SA 3.0"}}}]},{"pageid":58456052,"title":"File:Zebra 2013 10 06 1274.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Zebra_2013_10_06_1274.jpg/960px-Zebra_2013_10_06_1274.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zebra_2013_10_06_1274.jpg","extmetadata":{"ImageDescription":{"value":"Plains zebra (<i>Equus quagga  burchellii</i>, formerly <i>Equus burchellii</i>) drinking at a waterhole; KwaZulu-Natal, South Africa."},"DateTimeOriginal":{"value":"2013-10-06 09:55:18"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Alandmanson\" title=\"User:Alandmanson\">Alandmanson</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":61768842,"title":"File:Zeinis-Kops - Rind 01.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9b/Zeinis-Kops_-_Rind_01.jpg/960px-Zeinis-Kops_-_Rind_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zeinis-Kops_-_Rind_01.jpg","extmetadata":{"ImageDescription":{"value":"Cattle in the Kops and Zeinis lake area. Vorarlberg, Austria"},"DateTimeOriginal":{"value":"2017-07-16 09:45:02"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Basotxerri\" title=\"User:Basotxerri\">Basotxerri</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":88739840,"title":"File:Zentbechhofen Störche Nest-20200319-RM-151747.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Zentbechhofen_St%C3%B6rche_Nest-20200319-RM-151747.jpg/960px-Zentbechhofen_St%C3%B6rche_Nest-20200319-RM-151747.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zentbechhofen_St%C3%B6rche_Nest-20200319-RM-151747.jpg","extmetadata":{"ImageDescription":{"value":"Stork nest in Zentbechhofen in Middle Franconia"},"DateTimeOriginal":{"value":"2020-03-19 15:17:47"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Ermell\" title=\"User:Ermell\">Ermell</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":95113214,"title":"File:Zeeland, Netherlands ESA22256852.jpeg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Zeeland%2C_Netherlands_ESA22256852.jpeg/960px-Zeeland%2C_Netherlands_ESA22256852.jpeg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zeeland,_Netherlands_ESA22256852.jpeg","extmetadata":{"ImageDescription":{"value":"The Copernicus Sentinel-2 mission takes us over Zeeland – the westernmost province in the Netherlands.<br>Zoom in to see this image at its full 10 m resolution.<br>Located around 150 km from Amsterdam, Zeeland consists of a complex system of islands, peninsulas and waterways. It also comprises Zeeuwsch-Vlaanderen – a strip of the Flanders mainland between the Western Scheldt (Westerschelde) and Belgium.<br>The province of Zeeland lies on the large river delta at the mouth of several rivers, like the Scheldt (Schelde) and Meuse (Maas) rivers. The lighter aqua colours in the image depict the shallow waters of the delta with riverbeds and several sandbanks visible. The brown coloured waters indicate a higher sediment content, which contrasts with the darker waters of the North Sea.<br>The Port of Rotterdam, the largest seaport in Europe, is visible top-right in the image. Antwerp, in Belgium, is visible in the bottom-right and the quaint city of Bruges can be seen in the bottom-left of the image.<br>Zeeland is one of the main agricultural provinces in the Netherlands with one of the largest areas of arable farmland. The patchwork of agricultural fields visible on the islands and mainland show the fields in the various stages of growth or harvest. The area supports cereals, potatoes, beets, cattle and horticulture.<br>Large parts of Zeeland, which translates to ‘sea land,’ lie below sea level. The province was the site of a deadly flood in 1953 brought on by a combination of high spring tides and a strong windstorm that severely damaged the low-lying coastal region.<br>As a result, the Dutch government began to implement the Delta Project – an elaborate system of dykes, canals, dams and bridges to hold back the North Sea. In this image, the 9km-long Eastern Scheldt Storm Surge Barrier (Oosterscheldekering) is visible between the islands of Schouwen-Duiveland and Noord-Beveland.<br>Since sea-level rise is a key indicator of climate change, accurately monitoring the changing height of the sea surface over decades is essential for climate science, for policy-making and, ultimately, for protecting the lives of those in low-lying regions at risk.<br>The Copernicus Sentinel-6 Michael Freilich satellite, set to launch in November, is the first of two identical satellites to be launched sequentially to provide accurate measurements of sea level change.<br>Both satellites will reach 66°N and 66°S – a specific orbit occupied by the earlier missions that supplied the reference sea-surface height data over the last three decades. This orbit will allow for 95% of Earth’s ice-free ocean to be mapped every 10 days.<br>This image, acquired on 30 May 2020, is also featured on the Earth from Space video programme."},"DateTimeOriginal":{"value":"16 October 2020 (upload date)"},"Artist":{"value":"European Space Agency"},"LicenseShortName":{"value":"Attribution"}}}]},{"pageid":113004216,"title":"File:Zerlegung einer ausgebauten Stahlnietenbrücke in Leipzig Anger-Crottendorf (Dia).jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Zerlegung_einer_ausgebauten_Stahlnietenbr%C3%BCcke_in_Leipzig_Anger-Crottendorf_%28Dia%29.jpg/960px-Zerlegung_einer_ausgebauten_Stahlnietenbr%C3%BCcke_in_Leipzig_Anger-Crottendorf_%28Dia%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zerlegung_einer_ausgebauten_Stahlnietenbr%C3%BCcke_in_Leipzig_Anger-Crottendorf_(Dia).jpg","extmetadata":{"ImageDescription":{"value":"The extension of the steel superstructure of the Zweinaundorfer Straße railway crossing at the Leipziger Güterring took place by means of a mobile crane. Initially, only the superstructure of the directional track to Stötteritz was removed. Workers then began to dismantle the construction using autogenous flame cutting (oxy-fuel cutting). The scrapping lasted until the early morning hours of the following day."},"DateTimeOriginal":{"value":"2020-07-15 23:10:32"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Augustgeyler\" title=\"User:Augustgeyler\">August Geyler</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":123312308,"title":"File:Zentraler Blick durch den Alten Elbtunnel.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Zentraler_Blick_durch_den_Alten_Elbtunnel.jpg/960px-Zentraler_Blick_durch_den_Alten_Elbtunnel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zentraler_Blick_durch_den_Alten_Elbtunnel.jpg","extmetadata":{"ImageDescription":{"value":"View from the northern entrance through the <a href=\"https://en.wikipedia.org/wiki/Elbe_Tunnel_(1911)\" class=\"extiw\" title=\"en:Elbe Tunnel (1911)\">Old Elbe Tunnel</a> early in the morning."},"DateTimeOriginal":{"value":"2022-02-27 08:02:06"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:GZagatta&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:GZagatta (page does not exist)\">GZagatta</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":129141316,"title":"File:Zemmer Fürstenkreuz 1651 (2).jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Zemmer_F%C3%BCrstenkreuz_1651_%282%29.jpg/960px-Zemmer_F%C3%BCrstenkreuz_1651_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zemmer_F%C3%BCrstenkreuz_1651_(2).jpg","extmetadata":{"ImageDescription":{"value":"Wayside cross (1651), so-called \"Fürstenkreuz\", near <a href=\"https://en.wikipedia.org/wiki/Zemmer\" class=\"extiw\" title=\"en:Zemmer\">Zemmer-Schleidweiler</a>, Germany."},"DateTimeOriginal":{"value":"Taken on 27 February 2023"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Palauenc05\" title=\"User:Palauenc05\">Palauenc05</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":135148729,"title":"File:Zebra Family Luangwa Zambia Jul23 A7C 05903.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Zebra_Family_Luangwa_Zambia_Jul23_A7C_05903.jpg/960px-Zebra_Family_Luangwa_Zambia_Jul23_A7C_05903.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Zebra_Family_Luangwa_Zambia_Jul23_A7C_05903.jpg","extmetadata":{"ImageDescription":{"value":"<a hr