itle=\"User:Leviathan1983\">Mathias Krumbholz</a>"},"LicenseShortName":{"value":"CC BY-SA 3.0"}}}]},{"pageid":15165966,"title":"File:Luchsfliege Thereva sp 02 (MK).jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Luchsfliege_Thereva_sp_02_%28MK%29.jpg/960px-Luchsfliege_Thereva_sp_02_%28MK%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Luchsfliege_Thereva_sp_02_(MK).jpg","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Therevidae\" class=\"extiw\" title=\"en:Therevidae\">Therevidae</a> are a family of Diptera Asiloidea commonly known as stiletto flies. The family contains about 1,600 described species worldwide, most diverse in arid and semi-arid regions with sandy soils."},"DateTimeOriginal":{"value":"2011-05-09"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Leviathan1983\" title=\"User:Leviathan1983\">Mathias Krumbholz</a>"},"LicenseShortName":{"value":"CC BY-SA 3.0"}}}]},{"pageid":41332571,"title":"File:Lucky Dados en Madgarden Festival 2015 - 22.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Lucky_Dados_en_Madgarden_Festival_2015_-_22.jpg/960px-Lucky_Dados_en_Madgarden_Festival_2015_-_22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucky_Dados_en_Madgarden_Festival_2015_-_22.jpg","extmetadata":{"ImageDescription":{"value":"Lucky Dados at Madgarden Fest 2015, Madrid, Spain."},"DateTimeOriginal":{"value":"2015-07-01 18:53:20"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Kadellar\" title=\"User:Kadellar\">Carlos Delgado</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":41934382,"title":"File:Luchino Visconti 1972.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Luchino_Visconti_1972.jpg/960px-Luchino_Visconti_1972.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Luchino_Visconti_1972.jpg","extmetadata":{"ImageDescription":{"value":"Italian director <a href=\"https://en.wikipedia.org/wiki/Luchino_Visconti\" class=\"extiw\" title=\"en:Luchino Visconti\">Luchino Visconti</a> in 1972."},"DateTimeOriginal":{"value":"1972"},"Artist":{"value":"Marisa Rastellini (Mondadori Publisher)"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":51052642,"title":"File:Lüdinghausen, Borgmühle -- 2016 -- 3605.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/L%C3%BCdinghausen%2C_Borgm%C3%BChle_--_2016_--_3605.jpg/960px-L%C3%BCdinghausen%2C_Borgm%C3%BChle_--_2016_--_3605.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:L%C3%BCdinghausen,_Borgm%C3%BChle_--_2016_--_3605.jpg","extmetadata":{"ImageDescription":{"value":"Borgmühle in <a href=\"https://en.wikipedia.org/wiki/L%C3%BCdinghausen\" class=\"extiw\" title=\"en:Lüdinghausen\">Lüdinghausen</a>, <a href=\"https://en.wikipedia.org/wiki/North_Rhine-Westphalia\" class=\"extiw\" title=\"en:North Rhine-Westphalia\">North Rhine-Westphalia</a>, Germany<br><small>The Borgmühle is located in the town of Lüdinghausen in the <a href=\"https://en.wikipedia.org/wiki/M%C3%BCnster_(region)\" class=\"extiw\" title=\"en:Münster (region)\">Münsterland</a> region. The <a href=\"https://en.wikipedia.org/wiki/Watermill\" class=\"extiw\" title=\"en:Watermill\">watermill</a> was first mentioned in the Middle Ages and originally belonged to the nearby Lüdinghausen Castle. It served as a grain mill for centuries and was an important part of local agriculture.<br>The Borgmühle was powered by water from the <a href=\"https://en.wikipedia.org/wiki/Stever\" class=\"extiw\" title=\"en:Stever\">Stever</a> river. The mill wheel set the grinding mechanisms in motion and enabled local farmers to have their grain processed on site.<br>During the 20th century, the mill lost its economic importance. However, the historic building was preserved and restored. Today, the Borgmühle stands as a technical and cultural-historical monument to the milling tradition in the Münsterland region and serves as a reminder of the close connection between the nobility, agriculture, and craftsmanship.</small>"},"DateTimeOriginal":{"value":"Taken on 3 July 2016, 06:43"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":57150605,"title":"File:Lucerne Pilatus Lake panoramic 1180662.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Lucerne_Pilatus_Lake_panoramic_1180662.jpg/960px-Lucerne_Pilatus_Lake_panoramic_1180662.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucerne_Pilatus_Lake_panoramic_1180662.jpg","extmetadata":{"ImageDescription":{"value":"View of Lake Lucerne and the Pilatus with Lucerne"},"DateTimeOriginal":{"value":"2013-09-03 09:49:12"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Ermell\" title=\"User:Ermell\">Ermell</a>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":60276182,"title":"File:Lübeck, Historische Gerichtslaube -- 2017 -- 0476.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/L%C3%BCbeck%2C_Historische_Gerichtslaube_--_2017_--_0476.jpg/960px-L%C3%BCbeck%2C_Historische_Gerichtslaube_--_2017_--_0476.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:L%C3%BCbeck,_Historische_Gerichtslaube_--_2017_--_0476.jpg","extmetadata":{"ImageDescription":{"value":"Ceiling of the Historical Court Bower (Johannes D. Meyer-Fleckenstein, 1997), <a href=\"https://en.wikipedia.org/wiki/L%C3%BCbeck\" class=\"extiw\" title=\"en:Lübeck\">Lübeck</a>, <a href=\"https://en.wikipedia.org/wiki/Schleswig-Holstein\" class=\"extiw\" title=\"en:Schleswig-Holstein\">Schleswig-Holstein</a>, Germany"},"DateTimeOriginal":{"value":"Taken on 17 June 2017, 10:39"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":77503629,"title":"File:Lucy Arbell in Massenet's Thérèse.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Lucy_Arbell_in_Massenet%27s_Th%C3%A9r%C3%A8se.jpg/960px-Lucy_Arbell_in_Massenet%27s_Th%C3%A9r%C3%A8se.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucy_Arbell_in_Massenet%27s_Th%C3%A9r%C3%A8se.jpg","extmetadata":{"ImageDescription":{"value":"\"Théâtre national de l'Opéra-Comique, Thérèse, drame [musical], musique [de] Massenet : [Lucy Arbell] : enquête, R. Chavagnes\" - Poster design for the Paris première of <a href=\"https://en.wikipedia.org/wiki/Jules_Massenet\" class=\"extiw\" title=\"en:Jules Massenet\">Jules Massenet</a>'s <i><a href=\"https://en.wikipedia.org/wiki/Th%C3%A9r%C3%A8se_(opera)\" class=\"extiw\" title=\"en:Thérèse (opera)\">Thérèse</a></i>, featuring <a href=\"https://en.wikipedia.org/wiki/Lucy_Arbell\" class=\"extiw\" title=\"en:Lucy Arbell\">Lucy Arbell</a> as Thérèse. It's not clear what R. Chavagnes (presumably journalist <a href=\"https://fr.wikipedia.org/wiki/Ren%C3%A9_Chavagnes\" class=\"extiw\" title=\"fr:René Chavagnes\">René Chavagnes</a>) had to do with it, possibly he compiled a directory of images held."},"DateTimeOriginal":{"value":"1911"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":77765270,"title":"File:Lucy Arbell photographed by Paul Nadar.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Lucy_Arbell_photographed_by_Paul_Nadar.jpg/960px-Lucy_Arbell_photographed_by_Paul_Nadar.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucy_Arbell_photographed_by_Paul_Nadar.jpg","extmetadata":{"ImageDescription":{"value":"Photograph of <a href=\"https://en.wikipedia.org/wiki/Lucy_Arbell\" class=\"extiw\" title=\"en:Lucy Arbell\">Lucy Arbell</a>, mezzo-soprano opera singer. <a href=\"https://en.wikipedia.org/wiki/Carte_de_visite\" class=\"extiw\" title=\"en:Carte de visite\">Carte de visite</a> mount."},"DateTimeOriginal":{"value":"circa 1905<div style=\"display: none;\">date QS:P,+1905-00-00T00:00:00Z/9,P1480,Q5727902</div>"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Paul_Nadar\" class=\"extiw\" title=\"w:en:Paul Nadar\"><span title=\"French photographer (1856–1939)\">Paul Nadar</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":83218910,"title":"File:Lucretia Mott, signed photo, by F. Gutekunst.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Lucretia_Mott%2C_signed_photo%2C_by_F._Gutekunst.jpg/960px-Lucretia_Mott%2C_signed_photo%2C_by_F._Gutekunst.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucretia_Mott,_signed_photo,_by_F._Gutekunst.jpg","extmetadata":{"ImageDescription":{"value":"<p><a href=\"https://en.wikipedia.org/wiki/Lucretia_Mott\" class=\"extiw\" title=\"en:Lucretia Mott\">Lucretia Mott</a>, from the records of the <a href=\"https://en.wikipedia.org/wiki/National_Woman%27s_Party\" class=\"extiw\" title=\"en:National Woman's Party\">National Woman's Party</a>. Signature matches other signatures of hers.  Photographic print, 6. 5 x 4 in. (this may refer to the uncropped original, if so, nearer say, 5.5 x 3.5 as cropped)\n</p>\nFlipped version of the photograph published in The Suffragist, 8, no. 8 (Sept. 1920): 195, and The Suffragist, 8, no. 10 (Dec. 1920): 314."},"DateTimeOriginal":{"value":"circa 1870-1880"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Frederick_Gutekunst\" class=\"extiw\" title=\"w:en:Frederick Gutekunst\"><span title=\"American photographer (1831-1917)\">Frederick Gutekunst</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":91744219,"title":"File:Lucy Arbell as Queen Amahelli in Massenet's Bacchus, wide view.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Lucy_Arbell_as_Queen_Amahelli_in_Massenet%27s_Bacchus%2C_wide_view.jpg/960px-Lucy_Arbell_as_Queen_Amahelli_in_Massenet%27s_Bacchus%2C_wide_view.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucy_Arbell_as_Queen_Amahelli_in_Massenet%27s_Bacchus,_wide_view.jpg","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Lucy_Arbell\" class=\"extiw\" title=\"en:Lucy Arbell\">Lucy Arbell</a> as Queen Amahelli in <a href=\"https://en.wikipedia.org/wiki/Jules_Massenet\" class=\"extiw\" title=\"en:Jules Massenet\">Jules Massenet</a>'s <i><a href=\"https://en.wikipedia.org/wiki/Bacchus_(opera)\" class=\"extiw\" title=\"en:Bacchus (opera)\">Bacchus</a></i>"},"DateTimeOriginal":{"value":"circa 1909<div style=\"display: none;\">date QS:P,+1909-00-00T00:00:00Z/9,P1480,Q5727902</div>"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Paul_Nadar\" class=\"extiw\" title=\"w:en:Paul Nadar\"><span title=\"French photographer (1856–1939)\">Paul Nadar</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":127341911,"title":"File:Lucretius pointing to the casus.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Lucretius_pointing_to_the_casus.jpg/960px-Lucretius_pointing_to_the_casus.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucretius_pointing_to_the_casus.jpg","extmetadata":{"ImageDescription":{"value":"The Roman poet <a href=\"https://en.wikipedia.org/wiki/Lucretius\" class=\"extiw\" title=\"w:Lucretius\">Lucretius</a> pointing to the <i>casus,</i> the downward movement of the atoms. From the frontispiece to T. Lucretius Carus, <i>Of the Nature of Things</i>, translated by Thomas Creech, second and third editions, Oxford and London 1682–1683. Reproduced from the edition by [John Digby], 2 vols., London 1714. Designed by “T. C.”, possibly Thomas Creech (1659–1700). Drawn and engraved by Michael Burghers (1650–1727)."},"DateTimeOriginal":{"value":"1714"},"Artist":{"value":"Designed by “T. C.” (possibly Thomas Creech, died 1700); drawn and engraved by M. Burghers"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":145930088,"title":"File:Lucha entre clanes de la tribu Mundari, Terekeka, Sudán del Sur, 2024-01-29, DD 197.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Lucha_entre_clanes_de_la_tribu_Mundari%2C_Terekeka%2C_Sud%C3%A1n_del_Sur%2C_2024-01-29%2C_DD_197.jpg/960px-Lucha_entre_clanes_de_la_tribu_Mundari%2C_Terekeka%2C_Sud%C3%A1n_del_Sur%2C_2024-01-29%2C_DD_197.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucha_entre_clanes_de_la_tribu_Mundari,_Terekeka,_Sud%C3%A1n_del_Sur,_2024-01-29,_DD_197.jpg","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Nuba_wrestling\" class=\"extiw\" title=\"en:Nuba wrestling\">Nuba wrestling</a> of different clans of the <a href=\"https://en.wikipedia.org/wiki/Mundari_people\" class=\"extiw\" title=\"en:Mundari people\">Mundari tribe</a>, <a href=\"https://en.wikipedia.org/wiki/Terekeka\" class=\"extiw\" title=\"en:Terekeka\">Terekeka</a>, South Sudan."},"DateTimeOriginal":{"value":"2024-01-29 12:39:23"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q28147777\" class=\"extiw\" title=\"d:Q28147777\"><span title=\"Spanish photographer\">Diego Delso</span></a></bdi>"},"LicenseShortName":{"value":"CC BY-SA 4.0"}}}]},{"pageid":150905857,"title":"File:Lucie Delarue-Mardrus by Henri Manuel.jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Lucie_Delarue-Mardrus_by_Henri_Manuel.jpg/960px-Lucie_Delarue-Mardrus_by_Henri_Manuel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lucie_Delarue-Mardrus_by_Henri_Manuel.jpg","extmetadata":{"ImageDescription":{"value":"<p>Matte silver gelatin photograph, 18 x 13 cm. Conseil National des Femmes Françaises, 1928, From the Album Jane Misme, \"Journalistes françaises et confrères féministes\"\n</p><p><br>\n</p>\nNote that there was some contemporary (that is, from 1928) retouching. I've done what I can to reduce and restore this, but one can't tell exactly what was retouched away in some cases, so I just neatened it up. Compare <a href=\"//commons.wikimedia.org/wiki/File:Lucie_Delarue-Mardrus_by_Henri_Manuel_-_Original.png\" title=\"File:Lucie Delarue-Mardrus by Henri Manuel - Original.png\">the pre-restoration original</a>, where the 1928 retouching is fairly obvious."},"DateTimeOriginal":{"value":"1928"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Henri_Manuel\" class=\"extiw\" title=\"w:en:Henri Manuel\"><span title=\"French photographer (1874–1947)\">Henri Manuel</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]}]}}