d7/Eug%C3%A8ne_Grasset_-_A_La_Place_Clichy.jpg/960px-Eug%C3%A8ne_Grasset_-_A_La_Place_Clichy.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Eug%C3%A8ne_Grasset_-_A_La_Place_Clichy.jpg","extmetadata":{"ImageDescription":{"value":"\"A La Place Clichy\", an advertisement for <a href=\"https://en.wikipedia.org/wiki/oriental_rug\" class=\"extiw\" title=\"en:oriental rug\">oriental rugs</a> by <a href=\"https://en.wikipedia.org/wiki/Eug%C3%A8ne_Grasset\" class=\"extiw\" title=\"en:Eugène Grasset\">Eugène Grasset</a>. French lithograph, c. 1891.  803mm x 1192mm"},"DateTimeOriginal":{"value":"circa 1891<div style=\"display: none;\">date QS:P,+1891-00-00T00:00:00Z/9,P1480,Q5727902</div>"},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Eug%C3%A8ne_Grasset\" class=\"extiw\" title=\"w:en:Eugène Grasset\"><span title=\"French painter (1845-1917)\">Eugène Grasset</span></a></bdi> / <bdi><a href=\"https://en.wikipedia.org/wiki/User:Adam_Cuerden\" class=\"extiw\" title=\"en:User:Adam Cuerden\">Adam Cuerden</a></bdi>"},"LicenseShortName":{"value":"Public domain"}}}]},{"pageid":132783131,"title":"File:Eucomis kuiflelie. 07-06-2023. (d.j.b).jpg","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Eucomis_kuiflelie._07-06-2023._%28d.j.b%29.jpg/960px-Eucomis_kuiflelie._07-06-2023._%28d.j.b%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","descriptionurl":"https://commons.wikimedia.org/wiki/File:Eucomis_kuiflelie._07-06-2023._(d.j.b).jpg","extmetadata":{"ImageDescription":{"value":"Detail of a <i>Eucomis</i> (crested lily). The crest develops from the beautiful mottled stem. Focus stack of 16 photos."},"DateTimeOriginal":{"value":"2023-06-07 15:24:53"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Famberhorst\" title=\"User:Famberhorst\">Dominicus Johannes Bergsma</a>"},"LicenseShortName":{"v