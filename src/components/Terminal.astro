---
---

<section id="terminal">
	<h2>terminal</h2>
	<p class="lede">
		Ask questions about how any of this works. It runs on <em>your own computer</em> through{' '}
		<a href="https://ollama.com">Ollama</a>: nothing you type goes to this site or to any company.
	</p>

	<div class="term">
		<div class="bar">
			<span id="status">checking for ollama…</span>
			<select id="model" aria-label="model" hidden></select>
		</div>
		<div id="log" aria-live="polite"></div>
		<form id="ask">
			<span class="ps">&gt;</span>
			<input id="q" autocomplete="off" placeholder="how does real-time bidding work?" disabled />
		</form>
	</div>

	<details id="setup">
		<summary>set it up (free, one time)</summary>
		<ol>
			<li>Install Ollama from <a href="https://ollama.com/download">ollama.com/download</a>.</li>
			<li>Download a model: <pre>ollama pull qwen3:8b</pre></li>
			<li>Start it so this page is allowed to talk to it: <pre>OLLAMA_ORIGINS=https://aishipped.lol ollama serve</pre></li>
			<li>Reload this page. If your browser asks about access to local devices, allow it.</li>
		</ol>
	</details>
</section>

<script>
	const API = 'http://localhost:11434';
	const SYSTEM = `You are the terminal on aishipped.lol, a site about how the ad-funded internet works and how to opt out of it.
Explain mechanics plainly: ad tech, data brokers, recommendation algorithms, business incentives, privacy settings and laws.
Attribute outcomes to incentives and structures, not to hidden cabals or to any group of people.
When someone describes a problem, give concrete, free steps they can take (settings, open-source tools, offline alternatives).
Be concise, direct and honest. If you are not sure of a fact, say so.`;

	const log = document.getElementById('log')!;
	const status = document.getElementById('status')!;
	const modelSel = document.getElementById('model') as HTMLSelectElement;
	const input = document.getElementById('q') as HTMLInputElement;
	const history: { role: string; content: string }[] = [{ role: 'system', content: SYSTEM }];

	function line(cls: string, text = '') {
		const el = document.createElement('div');
		el.className = `line ${cls}`;
		el.textContent = text;
		log.appendChild(el);
		log.scrollTop = log.scrollHeight;
		return el;
	}

	async function connect() {
		try {
			const res = await fetch(`${API}/api/tags`);
			const { models } = await res.json();
			if (!models?.length) {
				status.textContent = 'ollama is running but has no models. run: ollama pull qwen3:8b';
				return;
			}
			for (const m of models) modelSel.add(new Option(m.name, m.name));
			const preferred = models.find((m: { name: string }) => m.name.startsWith('qwen3'));
			if (preferred) modelSel.value = preferred.name;
			modelSel.hidden = false;
			status.textContent = 'connected';
			input.disabled = false;
			line('sys', 'local model ready. ask anything.');
		} catch {
			status.textContent = 'ollama not found on this computer';
			line('sys', 'no local model found. open "set it up" below. it takes about five minutes.');
			(document.getElementById('setup') as HTMLDetailsElement).open = true;
		}
	}

	document.getElementById('ask')!.addEventListener('submit', async (e) => {
		e.preventDefault();
		const q = input.value.trim();
		if (!q) return;
		input.value = '';
		input.disabled = true;
		line('user', `> ${q}`);
		history.push({ role: 'user', content: q });
		const out = line('bot');

		try {
			const res = await fetch(`${API}/api/chat`, {
				method: 'POST',
				body: JSON.stringify({ model: modelSel.value, messages: history, stream: true, think: false }),
			});
			const reader = res.body!.getReader();
			const dec = new TextDecoder();
			let buf = '';
			let text = '';
			for (;;) {
				const { done, value } = await reader.read();
				if (done) break;
				buf += dec.decode(value, { stream: true });
				const parts = buf.split('\n');
				buf = parts.pop()!;
				for (const p of parts) {
					if (!p.trim()) continue;
					text += JSON.parse(p).message?.content ?? '';
					out.textContent = text.replace(/<think>[\s\S]*?<\/think>\s*/g, '');
					log.scrollTop = log.scrollHeight;
				}
			}
			history.push({ role: 'assistant', content: text });
		} catch {
			out.textContent = 'lost connection to ollama.';
		}
		input.disabled = false;
		input.focus();
	});

	connect();
</script>

<style>
	.term { background: #050706; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border-bottom: 1px solid var(--line);
		color: var(--dim);
		font-size: 0.8rem;
	}
	select { background: var(--panel); color: var(--text); border: 1px solid var(--line); font: inherit; max-width: 50%; }
	#log { height: 320px; overflow-y: auto; padding: 12px; }
	:global(.line) { white-space: pre-wrap; margin-bottom: 10px; font-size: 0.92rem; }
	:global(.line.user) { color: var(--green); }
	:global(.line.sys) { color: var(--dim); }
	form { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); }
	.ps { color: var(--green); }
	input { flex: 1; background: none; border: none; outline: none; color: var(--text); font: inherit; min-width: 0; }
	details { margin-top: 16px; }
	summary { cursor: pointer; color: var(--amber); }
	details li { margin-bottom: 8px; }
	details pre { margin: 6px 0; white-space: pre-wrap; word-break: break-all; }
</style>
