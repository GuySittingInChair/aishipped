		const subject = [f.subject].flat().filter(Boolean)[0] as string | undefined;
		return {
			id: `film:${f.identifier}`,
			src: 'films',
			title: f.title,
			sub: [f.year, 'Prelinger Archives'].filter(Boolean).join(' · '),
			body: f.description ? text([f.description].flat().join(' ')) : undefined,
