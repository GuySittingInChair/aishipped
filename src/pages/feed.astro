	const COMMONS = 'https://commons.wikimedia.org/w/api.php';
	async function photos() {
		const prefix = pick('ABCDEFGHIJKLMNOPRSTUVWZ'.split('')) + pick('aeioulnr'.split(''));
		const d = await relay('photos', 184, `${COMMONS}?${qs({
			action: 'query', format: 'json', origin: '*', generator: 'categorymembers',
			gcmtitle: 'Category:Featured_pictures_on_Wikimedia_Commons', gcmtype: 'file', gcmlimit: 20,
			gcmstartsortkeyprefix: prefix, prop: 'imageinfo', iiprop: 'url|extmetadata', iiurlwidth: small ? 640 : 960,
		})}`);
		return commonsCards(d);
	}
	function commonsCards(d: any): Card[] {
		return shuffle(Object.values(d.query?.pages ?? {}).map((p: any): Card | null => {
			const i = p.imageinfo?.[0];
			if (!i?.thumburl || (i.mime && !/^image\/(jpeg|png|webp|gif)/.test(i.mime))) return null;
			const m = i.extmetadata ?? {};
			const desc = m.ImageDescription ? text(m.ImageDescription.value) : '';
			return {
				id: `commons:${p.pageid}`,
				src: 'photos',
				title: (desc.split(/[.\n]/)[0] || p.title.replace(/^File:|\.\w+$/g, '')).slice(0, 140),
				sub: m.DateTimeOriginal ? text(m.DateTimeOriginal.value).slice(0, 40) : undefined,
				body: desc.length > 140 ? desc : undefined,
				img: i.thumburl,
				imgAlt: desc.slice(0, 200),
				link: i.descriptionurl,
				linkText: 'wikimedia commons',
				credit: [m.Artist && text(m.Artist.value), m.LicenseShortName?.value].filter(Boolean).join(' · '),
			};
		}).filter(Boolean) as Card[]);
	}

	async function history(given?: any): Promise<Card[]> {
		const d = given ?? await relay('history', 2000, `https://www.loc.gov/photos/?${qs({ fo: 'json', c: 25, sp: 1 + rand(2000), fa: 'online-format:image' })}`);
		return shuffle(d.results.map((r: any): Card | null => {
			const img = [...(r.image_url ?? [])].reverse().find((u: string) => /\.(jpg|gif|png)/.test(u));
			if (!img || !r.title) return null;
			return {
				id: `loc:${r.id}`,
				src: 'history',
				title: r.title.replace(/^\[|\]$/g, '').replace(/^Untitled$/i, 'untitled photograph'),
				sub: [r.date?.slice(0, 4), r.location?.slice(0, 2).join(', ')].filter(Boolean).join(' · '),
				body: [r.description].flat().filter(Boolean).join(' '),
				img: img.split('#')[0],
				imgAlt: r.title,
				link: r.url,
				linkText: 'loc.gov',
				credit: 'Library of Congress',
				more: async () => {
					const words = r.title.replace(/[^\w\s]/g, ' ').split(/\s+/).filter((w: string) => w.length > 3 && !/untitled/i.test(w)).slice(0, 3).join(' ');
					if (!words) return [];
					const d = await getJSON(`https://www.loc.gov/photos/?${qs({ fo: 'json', c: 20, q: words, fa: 'online-format:image' })}`);
					const all = await history(d);
					return all.filter((c) => c.id !== `loc:${r.id}`).slice(0, 3);
				},
			};
		}).filter(Boolean));
	}

	const SUBJECTS = ['love', 'science_fiction', 'fantasy', 'mystery', 'history', 'poetry', 'philosophy', 'adventure', 'animals', 'cooking', 'mathematics', 'music', 'art', 'travel', 'humor', 'biography', 'psychology', 'ocean', 'architecture', 'gardening', 'physics', 'short_stories'];
	function bookCard(w: any, subject: string): Card | null {
		if (!w.cover_id) return null;
		return {
			id: `book:${w.key}`,
			src: 'books',
			title: w.title,
			sub: [w.authors?.map((a: any) => a.name).join(', '), w.first_publish_year].filter(Boolean).join(' · '),
			body: `shelved under ${subject.replace(/_/g, ' ')}${w.has_fulltext ? ' · free to borrow or read online' : ''}`,
			img: `https://covers.openlibrary.org/b/id/${w.cover_id}-${small ? 'M' : 'L'}.jpg`,
			imgAlt: `cover of ${w.title}`,
			link: `https://openlibrary.org${w.key}`,
			linkText: 'openlibrary.org',
			more: async () => {
				const d = await getJSON(`https://openlibrary.org/subjects/${subject}.json?limit=40&offset=${rand(200)}`);
				return shuffle(d.works.map((x: any) => bookCard(x, subject)).filter(Boolean)).slice(0, 3);
			},
		};
	}
	async function books() {
		let subject = pick(SUBJECTS);
		const d = await relay('books', SUBJECTS.length * 15, `https://openlibrary.org/subjects/${subject}.json?limit=20&offset=${rand(300)}`);
