			return d.docs.map((w: any) => bookCard({ key: w.key, title: w.title, cover_id: w.cover_i, authors: w.author_name?.map((name: string) => ({ name })), first_publish_year: w.first_publish_year }, 'everything'))
				.filter(Boolean).map((c: Card) => ({ ...c, body: undefined, more: undefined }));
		},
		nasa: async () => {
