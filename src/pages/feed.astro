		design: async () => shuffle((await getJSON(`https://api.vam.ac.uk/v2/objects/search?${qs({ images_exist: 1, page_size: 20, page: 1 + rand(400) })}`)).records.map((r: any) => vamCard(r, '')).filter(Boolean)),
		curious: async () => shuffle((await getJSON(`https://api.wellcomecollection.org/catalogue/v2/images?${qs({ pageSize: 20, page: 1 + rand(500), 'locations.license': 'pdm,cc-0,cc-by' })}`)).results.map((r: any) => wellcomeCard(r, '')).filter(Boolean)),
		europe: async () => shuffle(((await getJSON(`https://api.europeana.eu/record/v2/search.json?${qs({ query: '*', wskey: 'api2demo', rows: 24, start: 1 + rand(975), media: 'true', reusability: 'open', qf: 'TYPE:IMAGE' })}`)).items ?? []).map(europeCard).filter(Boolean)),
		met: async () => {
