	const WELLCOME_Q = ['botany', 'anatomy', 'insects', 'skeleton', 'microscope', 'phrenology', 'herbal', 'zoology', 'brain', 'eye', 'heart', 'mushroom', 'plague', 'pharmacy', 'tattoo', 'dream', 'moon', 'ocean', 'birds'];
	function wellcomeCard(r: any, q: string): Card | null {
		const loc = r.locations?.find((l: any) => /info\.json$/.test(l.url));
		if (!loc || !r.source?.title) return null;
		const [title, ...rest] = r.source.title.split(/\.\s/);
		return {
			id: `wellcome:${r.id}`,
			src: 'curious',
			title: title.slice(0, 160),
			body: rest.join('. ') || undefined,
			img: loc.url.replace('/info.json', `/full/!${small ? 600 : 900},${small ? 600 : 900}/0/default.jpg`),
			imgAlt: r.source.title.slice(0, 200),
			link: `https://wellcomecollection.org/works/${r.source.id}`,
			linkText: 'wellcomecollection.org',
			credit: `Wellcome Collection · ${loc.license?.label ?? ''}`,
			more: async () => {
				const d = await getJSON(`https://api.wellcomecollection.org/catalogue/v2/images?${qs({ query: q, pageSize: 20, page: 1 + rand(3), 'locations.license': 'pdm,cc-0,cc-by' })}`);
				return shuffle(d.results.filter((x: any) => x.id !== r.id).map((x: any) => wellcomeCard(x, q)).filter(Boolean)).slice(0, 3);
			},
		};
	}
	async function curious() {
