	}

	async function planet() {
		const d = await getJSON('https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson');
		return shuffle(d.features).slice(0, 4).map((f: any): Card => {
			const p = f.properties;
			const ago = Math.round((Date.now() - p.time) / 3600000);
			const [lon, lat, depth] = f.geometry.coordinates;
			return {
				id: `quake:${f.id}`,
				src: 'planet',
				title: `magnitude ${p.mag.toFixed(1)}: ${p.place ?? 'somewhere on Earth'}`,
				sub: `${ago < 1 ? 'under an hour' : ago + ' h'} ago · ${Math.round(depth)} km deep${p.tsunami ? ' · tsunami flag' : ''}`,
				body: `One of ${d.features.length} earthquakes of magnitude 4.5+ on Earth in the last 24 hours. Each step of magnitude is about 32× more energy, so this one released roughly ${Math.round(10 ** (1.5 * p.mag + 4.8) / 4.184e9).toLocaleString()} kg of TNT's worth.`,
				link: p.url,
				linkText: 'usgs.gov',
				extra: [`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=6/${lat}/${lon}`, 'map'],
			};
		});
	}

