	const records = async () => shuffle((await getJSON(`https://archive.org/advancedsearch.php?${qs({ q: 'collection:georgeblood', 'fl[]': 'identifier', rows: 25, page: 1 + rand(60), 'sort[]': 'downloads desc', output: 'json' })}${REC_FL}`)).response.docs.map(recordCard).filter(Boolean));

	// ---- security: downloaded and screened at build time (scripts/snapshot.mjs) ----
	const cyber = async () => shuffle((await snapshot('cyber')).map((c: Card) => ({ ...c, src: 'cyber' })));

	// ---- uncurated mode ----------------------------------------------------------
	// Every curated list above (featured, most-voted, trending, museum highlights, my topic lists) is
	// someone's selection. Uncurated mode replaces each with a uniform random draw from the whole
	// collection, and switches off sources that only exist as somebody's picks.
	const R_KEY = 'aishipped.feed.raw';
	const rawBox = document.getElementById('raw') as HTMLInputElement;
	rawBox.checked = load<boolean>(R_KEY, false);
	const isRaw = () => rawBox.checked && !fixedData;
	const RAW: Record<string, (() => Promise<Card[]>) | null> = {
		featured: null, today: null, hn: null, fedi: null, space: null, amour: null,
		art: async () => shuffle((await getJSON(`${CMA}?${qs({ has_image: 1, limit: 20, skip: rand(60000) })}`)).data.map(cmaCard).filter(Boolean)),
		nature: async () => shuffle((await getJSON(`${INAT}?${qs({ photos: 'true', quality_grade: 'research', id_above: rand(300_000_000), order_by: 'id', order: 'asc', per_page: 30 })}`)).results.map(natureCard).filter(Boolean)),
		photos: async () => commonsCards(await getJSON(`${COMMONS}?${qs({
			action: 'query', format: 'json', origin: '*', generator: 'random', grnnamespace: 6, grnlimit: 20,
			prop: 'imageinfo', iiprop: 'url|extmetadata|mime', iiurlwidth: small ? 640 : 960,
		})}`)),
		books: async () => {
