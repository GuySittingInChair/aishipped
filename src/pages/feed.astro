---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';

// snapshot counts are baked into the page so the first fetch needs no round trip
let snaps = '{}';
try { snaps = readFileSync('public/data/manifest.json', 'utf8'); } catch {}

// one batch per source baked into the HTML, so the first screen needs no requests at all
const start: Record<string, unknown> = {};
for (const [src, n] of Object.entries(JSON.parse(snaps) as Record<string, number>)) {
	if (!n || !['nature', 'poems', 'featured', 'history', 'art', 'photos'].includes(src)) continue;
	try { start[src] = JSON.parse(readFileSync(`public/data/${src}-${Math.floor(Math.random() * n)}.json`, 'utf8')); } catch {}
}
const startJSON = JSON.stringify(start).replace(/</g, '\\u003c');

const sources = [
	['art', 'art', 'public-domain paintings, prints and objects from the Art Institute of Chicago', 3],
	['nature', 'nature', 'the most-loved wildlife photos on iNaturalist, identified by people who know', 3],
	['featured', 'wikipedia: best of', 'featured articles, pictures of the day, "did you know" and on-this-day, from a random day since 2016', 3],
	['random', 'wikipedia: random', 'a truly random article. most are small. some are wonderful', 2],
	['space', 'space', "NASA's astronomy picture of the day, from any day since 1995", 2],
	['poems', 'poems', 'short public-domain poems', 2],
	['automata', 'automata', 'one-dimensional cellular automata drawn on your own machine', 1],
	['photos', 'photos', 'featured pictures on Wikimedia Commons, voted the best of 100 million files', 3],
	['history', 'old photos', 'photographs from the Library of Congress, mostly 1860s–1960s', 2],
	['books', 'books', 'classic and well-loved books from Open Library, by subject', 2],
	['planet', 'the planet right now', 'earthquakes from the last day, live from the US Geological Survey', 1],
	['fedi', 'fediverse', 'posts people are boosting on mastodon.social right now', 1],
	['films', 'old films', 'public-domain films from the Prelinger Archives: ads, newsreels, how-to films, 1910s–1970s. tap to play', 2],
	['today', 'today', "what the world is reading on Wikipedia right now, and today's news", 1],
	['nasa', 'NASA archive', "pictures from NASA's image library: missions, telescopes, launches", 2],
	['design', 'design', 'textiles, posters, ceramics, jewellery and dress from the V&A in London', 2],
	['curious', 'curiosities', 'old medical, botanical and scientific images from the Wellcome Collection', 2],
	['europe', 'europe’s museums', 'open-licensed images from thousands of European museums, libraries and archives via Europeana', 2],
	['amour', 'amour', 'off by default: love poems and the nude in art, from Cleveland museum and PoetryDB', 0],
	['hn', 'people talking', 'the best recent links on Hacker News, with their comment threads', 1],
] as const;
---

<Base title="the feed · aishipped.lol" description="An endless scroll with no ads, no tracking and an algorithm you set yourself.">
		<link rel="preconnect" href="https://en.wikipedia.org" crossorigin />
	<link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
	<link rel="preconnect" href="https://api.inaturalist.org" crossorigin />
	<link rel="preconnect" href="https://inaturalist-open-data.s3.amazonaws.com" crossorigin />
	<link rel="preconnect" href="https://openaccess-api.clevelandart.org" crossorigin />
	<link rel="preconnect" href="https://openaccess-cdn.clevelandart.org" crossorigin />
	<link rel="preconnect" href="https://api.artic.edu" crossorigin />
	<link rel="preconnect" href="https://www.artic.edu" crossorigin />
	<link rel="preconnect" href="https://commons.wikimedia.org" crossorigin />
	<link rel="preconnect" href="https://poetrydb.org" crossorigin />
	<link rel="preconnect" href="https://archive.org" crossorigin />
	<link rel="preconnect" href="https://www.loc.gov" crossorigin />
	<link rel="preconnect" href="https://tile.loc.gov" crossorigin />
	<link rel="preconnect" href="https://openlibrary.org" crossorigin />
	<link rel="preconnect" href="https://covers.openlibrary.org" crossorigin />
	<link rel="preconnect" href="https://images-api.nasa.gov" crossorigin />
	<link rel="preconnect" href="https://images-assets.nasa.gov" crossorigin />
	<link rel="preconnect" href="https://mastodon.social" crossorigin />
	<link rel="preconnect" href="https://earthquake.usgs.gov" crossorigin />
	<script type="application/json" id="snaps" set:html={snaps} />
	<script type="application/json" id="start" set:html={startJSON} />
	<div class="bar" id="bar">
		<a href="/" class="home">aishipped.lol</a>
		<span class="stat"><span id="clock">0 min</span> · <span id="count">0</span> cards</span>
		<span class="spacer"></span>
		<button id="tuneBtn" aria-expanded="false" aria-controls="tune">tune</button>
		<button id="savedBtn" aria-controls="saved">saved <span id="savedCount">0</span></button>
	</div>

	<main>
		<header class="hero">
			<p class="prompt">$ cat /feed</p>
			<h1>the feed<span class="cursor">_</span></h1>
			<p class="tag">an endless scroll that isn't farming you.</p>
			<ol class="rules">
				<li><b>you are the algorithm.</b> Press <em>tune</em>: each slider is how often a kind of card shows up. That is the whole ranking.</li>
				<li><b>every card tells you why it's here.</b> No hidden engagement score. Cards are picked at random using your weights.</li>
				<li><b>nothing is tracked.</b> This page has no analytics. Your weights and saves stay in this browser.</li>
				<li><b>everything is credited and linked.</b> All of it comes from museums, Wikipedia, NASA and people who share their work openly.</li>
				<li><b>it shows you the clock.</b> The time you've spent is at the top, and every chapter ends with a place to stop.</li>
			</ol>
			<p class="keys">keys: <kbd>j</kbd>/<kbd>k</kbd> next/previous card · <kbd>s</kbd> save · <kbd>m</kbd> more like this</p>
		</header>

		<div id="stream"></div>
		<p id="sentinel">loading…</p>
	</main>

	<aside id="tune" class="panel" hidden>
		<h2>tune</h2>
		<p class="lede">How often each kind of card shows up. 0 turns it off.</p>
		{sources.map(([id, name, desc, w]) => (
			<label class="slider">
				<span class="name">{name} <output data-for={id}>{w}</output></span>
				<input type="range" min="0" max="5" step="1" value={w} data-src={id} data-default={w} />
				<span class="desc">{desc}</span>
			</label>
		))}
		<label class="slider">
			<span class="name">chapter length <output data-for="chapter">25</output></span>
			<input type="range" min="10" max="60" step="5" value="25" id="chapterLen" />
			<span class="desc">cards between each stopping point</span>
		</label>
		<p class="lede audit">
			What decides the order: a random draw using the weights above, nothing else. No model, no profile, no history of what
			you clicked; the code is <a href="https://github.com/GuySittingInChair/aishipped/blob/main/src/pages/feed.astro">here</a>.
			Some sources hand over their own popular lists (wildlife and Hacker News by votes, Mastodon trends, Wikipedia's most read),
			ranked the same for everyone. Set those to 0 for a feed with no popularity in it at all.
		</p>
		<p class="row"><button id="forgetSeen">forget what I've seen</button> <button id="resetTune">reset</button> <button data-close>done</button></p>
	</aside>

	<aside id="saved" class="panel" hidden>
		<h2>saved</h2>
		<p class="lede">Kept in this browser only.</p>
		<ul id="savedList"></ul>
		<p class="row"><button id="exportSaved">copy as text</button> <button data-close>done</button></p>
	</aside>
</Base>

<script>
	type Card = {
		id: string;
		src: string;
		title: string;
		sub?: string;
		body?: string;
		verse?: boolean;
		img?: string;
		imgAlt?: string;
		placeholder?: string;
		link: string;
		linkText?: string;
		extra?: [string, string];
		credit?: string;
		draw?: (c: HTMLCanvasElement) => void;
		embed?: string;
		more?: () => Promise<Card[]>;
	};

	const W_KEY = 'aishipped.feed.weights';
	const S_KEY = 'aishipped.feed.saved';
	const load = <T,>(k: string, d: T): T => {
		try { return JSON.parse(localStorage.getItem(k) || '') ?? d; } catch { return d; }
	};
	const store = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };

	// phones get smaller images: same look, a fraction of the bytes
	const small = innerWidth * devicePixelRatio < 1100;
	const rand = (n: number) => Math.floor(Math.random() * n);
	const pick = <T,>(a: T[]) => a[rand(a.length)];
	const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = rand(i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; };
	const getJSON = async (url: string, ms = 20000) => {
		const r = await fetch(url, { signal: AbortSignal.timeout(ms) });
		if (!r.ok) throw new Error(`${r.status} ${url}`);
		return r.json();
	};
	// slow sources go through our CDN cache first, then straight to the source if that fails
	// fastest first: a build-time snapshot on the CDN, then the cached relay, then the source itself
	const snaps: Promise<Record<string, number>> = Promise.resolve(JSON.parse(document.getElementById('snaps')?.textContent || '{}'));
	const start: Record<string, any> = JSON.parse(document.getElementById('start')?.textContent || '{}');
	const snapshot = async (s: string) => {
		if (start[s]) { const d = start[s]; delete start[s]; return d; }
		const n = (await snaps)[s];
		if (!n) throw new Error('no snapshot');
		return getJSON(`/data/${s}-${rand(n)}.json`, 4000);
	};
	const relay = (s: string, pages: number, direct: string) =>
		snapshot(s)
			.catch(() => getJSON(`/api/src?s=${s}&p=${rand(pages)}`, 5000))
			.catch(() => getJSON(direct));
	const text = (html: string) => new DOMParser().parseFromString(html, 'text/html').body.textContent?.trim() ?? '';
	const qs = (o: Record<string, string | number>) => new URLSearchParams(Object.entries(o).map(([k, v]) => [k, String(v)])).toString();

	// ---- sources ------------------------------------------------------------

	const AIC = 'https://api.artic.edu/api/v1/artworks/search';
	const AIC_FIELDS = 'id,title,image_id,artist_display,artist_id,date_display,medium_display,thumbnail';
	function artCard(a: any): Card | null {
		if (!a.image_id) return null;
		return {
			id: `art:${a.id}`,
			src: 'art',
			title: a.title,
			sub: [a.artist_display?.split('\n')[0], a.date_display].filter(Boolean).join(' · '),
			body: a.medium_display,
			img: `https://www.artic.edu/iiif/2/${a.image_id}/full/${small ? 600 : 843},/0/default.jpg`,
			imgAlt: a.thumbnail?.alt_text || a.title,
			placeholder: a.thumbnail?.lqip,
			link: `https://www.artic.edu/artworks/${a.id}`,
			linkText: 'artic.edu',
			credit: 'Art Institute of Chicago · public domain',
			more: a.artist_id ? async () => {
				const d = await getJSON(`${AIC}?query[bool][must][0][term][artist_id]=${a.artist_id}&query[bool][must][1][term][is_public_domain]=true&limit=12&fields=${AIC_FIELDS}`);
				return shuffle(d.data.map(artCard).filter(Boolean)).slice(0, 3);
			} : undefined,
		};
	}
	const CMA = 'https://openaccess-api.clevelandart.org/api/artworks/';
	function cmaCard(a: any): Card | null {
		const img = a.images?.web?.url;
		if (!img) return null;
		const who = a.creators?.[0];
		return {
			id: `cma:${a.id}`,
			src: 'art',
			title: a.title,
			sub: [who?.description, a.creation_date].filter(Boolean).join(' · '),
			body: [a.technique, a.wall_description || a.description || a.fun_fact].filter(Boolean).map(text).join('\n'),
			img,
			imgAlt: a.title,
			link: a.url,
			linkText: 'clevelandart.org',
			credit: 'Cleveland Museum of Art · CC0',
			more: who?.id ? async () => {
				const d = await getJSON(`${CMA}?${qs({ cc0: 1, has_image: 1, limit: 12, artists: who.description.split(' (')[0] })}`);
				return shuffle(d.data.filter((x: any) => x.id !== a.id).map(cmaCard).filter(Boolean)).slice(0, 3);
			} : undefined,
		};
	}
	const cma = async () => shuffle((await relay('art', 2050, `${CMA}?${qs({ cc0: 1, has_image: 1, limit: 20, skip: rand(41000) })}`)).data.map(cmaCard).filter(Boolean));
	const aic = async () => shuffle((await getJSON(`${AIC}?query[term][is_public_domain]=true&limit=20&page=${1 + rand(490)}&fields=${AIC_FIELDS}`)).data.map(artCard).filter(Boolean));
	// two museums; if one refuses, the other covers
	const art = () => (Math.random() < 0.5 ? cma() : aic()).catch(() => cma()).catch(() => aic());

	const INAT = 'https://api.inaturalist.org/v1/observations';
	function natureCard(o: any): Card | null {
		const photo = o.photos?.[0];
		if (!photo || !o.taxon) return null;
		const t = o.taxon;
		return {
			id: `nature:${o.id}`,
			src: 'nature',
			title: t.preferred_common_name ? t.preferred_common_name[0].toUpperCase() + t.preferred_common_name.slice(1) : t.name,
			sub: [t.preferred_common_name ? t.name : '', o.place_guess, o.observed_on].filter(Boolean).join(' · '),
			img: photo.url.replace('/square.', small ? '/medium.' : '/large.'),
			imgAlt: t.preferred_common_name || t.name,
			link: o.uri,
			linkText: 'inaturalist.org',
			extra: t.wikipedia_url ? [t.wikipedia_url.replace('http:', 'https:'), 'wikipedia'] : undefined,
			credit: photo.attribution,
			more: async () => {
				const d = await getJSON(`${INAT}?${qs({ taxon_id: t.id, photos: 'true', quality_grade: 'research', order_by: 'votes', per_page: 12 })}`);
				return shuffle(d.results.filter((x: any) => x.id !== o.id).map(natureCard).filter(Boolean)).slice(0, 3);
			},
		};
	}
	async function nature() {
		const d = await relay('nature', 190, `${INAT}?${qs({ quality_grade: 'research', photos: 'true', order_by: 'votes', per_page: 50, page: 1 + rand(190) })}`);
		return shuffle(d.results.map(natureCard).filter(Boolean));
	}

	const WIKI = 'https://en.wikipedia.org/w/api.php';
	function wikiCard(p: any, src: string): Card {
		return {
			id: `wiki:${p.pageid ?? p.title}`,
			src,
			title: p.title,
			sub: p.description,
			body: p.extract,
			img: p.thumbnail?.source,
			imgAlt: p.title,
			link: `https://en.wikipedia.org/wiki/${encodeURIComponent(p.title.replace(/ /g, '_'))}`,
			linkText: 'wikipedia',
			credit: 'Wikipedia · CC BY-SA',
			more: () => wikiQuery({ generator: 'search', gsrsearch: `morelike:${p.title}`, gsrlimit: 4 }, src).then((c) => c.slice(0, 3)),
		};
	}
	async function wikiQuery(params: Record<string, string | number>, src: string) {
		const d = await getJSON(`${WIKI}?${qs({
			action: 'query', format: 'json', origin: '*', prop: 'extracts|pageimages|description',
			exintro: 1, explaintext: 1, exlimit: 20, pithumbsize: small ? 500 : 800, ...params,
		})}`);
		return Object.values(d.query?.pages ?? {})
			.sort((a: any, b: any) => (a.index ?? 0) - (b.index ?? 0))
			.map((p: any) => wikiCard(p, src));
	}
	async function random() {
		const cards = await wikiQuery({ generator: 'random', grnnamespace: 0, grnlimit: 20 }, 'random');
		return cards.filter((c) => (c.body?.length ?? 0) > 250);
	}

	async function featured() {
		const start = Date.UTC(2016, 0, 1);
		const p = rand(Math.min(3900, Math.floor((Date.now() - start) / 864e5) - 1));
		const direct = `https://en.wikipedia.org/api/rest_v1/feed/featured/${new Date(start + p * 864e5).toISOString().slice(0, 10).replace(/-/g, '/')}`;
		const d = await relay('featured', 3900, direct);
		const day = new Date(d.date ?? start + p * 864e5);
		const out: Card[] = [];
		const nice = day.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
		if (d.tfa) {
			const c = wikiCard({ title: d.tfa.titles?.normalized ?? d.tfa.title, description: d.tfa.description, extract: d.tfa.extract, thumbnail: d.tfa.thumbnail, pageid: d.tfa.pageid }, 'featured');
			c.sub = `featured article, ${nice}` + (d.tfa.description ? ` · ${d.tfa.description}` : '');
			out.push(c);
		}
		if (d.image?.thumbnail) {
			out.push({
				id: `potd:${d.image.title}`,
				src: 'featured',
				title: d.image.description?.text ? text(d.image.description.html ?? d.image.description.text).slice(0, 160) : d.image.title.replace(/^File:/, ''),
				sub: `picture of the day, ${nice}`,
				img: d.image.thumbnail.source,
				imgAlt: d.image.description?.text ?? '',
				link: d.image.file_page,
				linkText: 'wikimedia commons',
				credit: [d.image.artist?.text, d.image.license?.type].filter(Boolean).join(' · '),
			});
		}
		for (const e of shuffle(d.onthisday ?? []).slice(0, 3)) {
			const p = e.pages?.[0];
			out.push({
				id: `otd:${e.year}:${e.text.slice(0, 40)}`,
				src: 'featured',
				title: String(e.year),
				sub: `on this day: ${day.toLocaleDateString('en', { month: 'long', day: 'numeric', timeZone: 'UTC' })}`,
				body: e.text,
				img: p?.thumbnail?.source,
				imgAlt: p?.title,
				link: p ? p.content_urls?.desktop?.page ?? `https://en.wikipedia.org/wiki/${p.title}` : 'https://en.wikipedia.org/wiki/Wikipedia:On_this_day',
				linkText: 'wikipedia',
				more: p ? () => wikiQuery({ titles: e.pages.slice(0, 3).map((x: any) => x.titles?.normalized ?? x.title).join('|') }, 'featured') : undefined,
			});
		}
		for (const y of shuffle(d.dyk ?? []).slice(0, 3)) {
			const doc = new DOMParser().parseFromString(y.html, 'text/html');
			const a = doc.querySelector('b a, a');
			const title = a?.getAttribute('title');
			out.push({
				id: `dyk:${y.text.slice(0, 50)}`,
				src: 'featured',
				title: 'did you know…',
				body: '…' + text(y.html).replace(/^\.\.\.\s*/, ' '),
				link: title ? `https://en.wikipedia.org/wiki/${encodeURIComponent(title.replace(/ /g, '_'))}` : 'https://en.wikipedia.org/wiki/Wikipedia:Did_you_know',
				linkText: 'wikipedia',
				more: title ? () => wikiQuery({ titles: title }, 'featured') : undefined,
			});
		}
		return shuffle(out);
	}

	async function space() {
		const d = await relay('space', 30, 'https://api.nasa.gov/planetary/apod?api_key=DEMO_KEY&count=10&thumbs=true');
		return d
			.filter((a: any) => a.media_type === 'image' && a.url && !/nasa-logo/.test(a.url))
			.map((a: any): Card => ({
				id: `apod:${a.date}`,
				src: 'space',
				title: a.title,
				sub: `astronomy picture of the day · ${a.date}`,
				body: a.explanation,
				img: a.url,
				imgAlt: a.title,
				link: `https://apod.nasa.gov/apod/ap${a.date.slice(2).replace(/-/g, '')}.html`,
				linkText: 'apod.nasa.gov',
				credit: a.copyright ? `© ${a.copyright.trim()}` : 'NASA · public domain',
			}));
	}

	function poemCard(p: any): Card {
		return {
			id: `poem:${p.author}:${p.title}`,
			src: 'poems',
			title: p.title,
			sub: p.author,
			body: p.lines.join('\n').replace(/\n{3,}/g, '\n\n'),
			verse: true,
			link: `https://www.gutenberg.org/ebooks/search/?query=${encodeURIComponent(p.author)}`,
			linkText: 'gutenberg',
			more: async () => {
				const d = await getJSON(`https://poetrydb.org/author/${encodeURIComponent(p.author)}/title,author,lines,linecount`);
				return shuffle(Array.isArray(d) ? d.filter(short).filter((x: any) => x.title !== p.title) : []).slice(0, 2).map(poemCard);
			},
		};
	}
	const short = (p: any) => +p.linecount >= 4 && +p.linecount <= 40;
	async function poems() {
		const d = await snapshot('poems').catch(() => getJSON('https://poetrydb.org/random/20/title,author,lines,linecount'));
		return d.filter(short).map(poemCard);
	}

	const COMMONS = 'https://commons.wikimedia.org/w/api.php';
	async function photos() {
		const prefix = pick('ABCDEFGHIJKLMNOPRSTUVWZ'.split('')) + pick('aeioulnr'.split(''));
		const d = await relay('photos', 184, `${COMMONS}?${qs({
			action: 'query', format: 'json', origin: '*', generator: 'categorymembers',
			gcmtitle: 'Category:Featured_pictures_on_Wikimedia_Commons', gcmtype: 'file', gcmlimit: 20,
			gcmstartsortkeyprefix: prefix, prop: 'imageinfo', iiprop: 'url|extmetadata', iiurlwidth: small ? 640 : 960,
		})}`);
		return shuffle(Object.values(d.query?.pages ?? {}).map((p: any): Card | null => {
			const i = p.imageinfo?.[0];
			if (!i?.thumburl) return null;
			const m = i.extmetadata ?? {};
			const desc = m.ImageDescription ? text(m.ImageDescription.value) : '';
			return {
				id: `commons:${p.pageid}`,
				src: 'photos',
				title: (desc.split(/[.\n]/)[0] || p.title.replace(/^File:|\.\w+$/g, '')).slice(0, 140),
				sub: m.DateTimeOriginal ? text(m.DateTimeOriginal.value).slice(0, 40) : undefined,
				body: desc.length > 140 ? desc : undefined,
				img: i.thumburl,
				imgAlt: desc.slice(0, 200),
				link: i.descriptionurl,
				linkText: 'wikimedia commons',
				credit: [m.Artist && text(m.Artist.value), m.LicenseShortName?.value].filter(Boolean).join(' · '),
			};
		}).filter(Boolean) as Card[]);
	}

	async function history() {
		const d = await relay('history', 2000, `https://www.loc.gov/photos/?${qs({ fo: 'json', c: 25, sp: 1 + rand(2000), fa: 'online-format:image' })}`);
		return shuffle(d.results.map((r: any): Card | null => {
			const img = [...(r.image_url ?? [])].reverse().find((u: string) => /\.(jpg|gif|png)/.test(u));
			if (!img || !r.title) return null;
			return {
				id: `loc:${r.id}`,
				src: 'history',
				title: r.title.replace(/^\[|\]$/g, '').replace(/^Untitled$/i, 'untitled photograph'),
				sub: [r.date?.slice(0, 4), r.location?.slice(0, 2).join(', ')].filter(Boolean).join(' · '),
				body: [r.description].flat().filter(Boolean).join(' '),
				img: img.split('#')[0],
				imgAlt: r.title,
				link: r.url,
				linkText: 'loc.gov',
				credit: 'Library of Congress',
			};
		}).filter(Boolean));
	}

