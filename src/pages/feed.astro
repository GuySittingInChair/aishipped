	const RULES = [18, 22, 30, 45, 54, 57, 60, 62, 73, 75, 86, 89, 90, 99, 101, 105, 106, 109, 110, 120, 122, 124, 126, 129, 135, 137, 146, 147, 149, 150, 153, 161, 165, 169, 182, 193, 195, 225];
	function automatonCard(rule: number, seedKind: number): Card {
		const bits = rule.toString(2).padStart(8, '0');
		const table = ['111', '110', '101', '100', '011', '010', '001', '000'].map((k, i) => `${k}→${bits[i]}`).join('  ');
		const seedName = ['one live cell', 'random noise', 'a few scattered cells'][seedKind];
		return {
			id: `ca:${rule}:${seedKind}:${Math.random()}`,
			src: 'automata',
			title: `rule ${rule}`,
			sub: `starting from ${seedName}`,
			body: `Each row is made from the row above with only these eight rules, reading each cell and its two neighbours:\n${table}\nNo one designed this picture; it falls out of the number ${rule}.`,
			link: `https://mathworld.wolfram.com/ElementaryCellularAutomaton.html`,
			linkText: 'how it works',
			draw: (c) => {
				const cols = 240, rows = 150;
				c.width = cols; c.height = rows;
				const g = c.getContext('2d')!;
				const css = getComputedStyle(document.documentElement);
				const hue = rand(360);
				g.fillStyle = css.getPropertyValue('--panel') || '#111';
				g.fillRect(0, 0, cols, rows);
				let row = new Uint8Array(cols);
				if (seedKind === 0) row[cols >> 1] = 1;
				else if (seedKind === 1) row = row.map(() => +(Math.random() < 0.5));
				else for (let i = 0; i < 6; i++) row[rand(cols)] = 1;
				for (let y = 0; y < rows; y++) {
					g.fillStyle = `hsl(${(hue + y * 0.6) % 360} 90% 70%)`;
					for (let x = 0; x < cols; x++) if (row[x]) g.fillRect(x, y, 1, 1);
					const next = new Uint8Array(cols);
					for (let x = 0; x < cols; x++) {
						const k = (row[(x + cols - 1) % cols] << 2) | (row[x] << 1) | row[(x + 1) % cols];
						next[x] = (rule >> k) & 1;
					}
					row = next;
				}
			},
			more: async () => [0, 1, 2].filter((s) => s !== seedKind).map((s) => automatonCard(rule, s)),
		};
	}
	async function automata() {
		return Array.from({ length: 4 }, () => automatonCard(pick(RULES), rand(3)));
	}

	const SOURCES: Record<string, { name: string; fill: () => Promise<Card[]>; queue: Card[]; pending?: Promise<void>; fails: number }> = {};
	const fills: Record<string, () => Promise<Card[]>> = { art, nature, featured, random, space, poems, automata, hn, amour, design, curious, europe, films, today, nasa, photos, history, books, planet, fedi };
	for (const input of document.querySelectorAll<HTMLInputElement>('#tune input[data-src]')) {
		const id = input.dataset.src!;
		SOURCES[id] = { name: input.closest('label')!.querySelector('.name')!.firstChild!.textContent!.trim(), fill: fills[id], queue: [], fails: 0 };
	}

	function refill(id: string) {
		const s = SOURCES[id];
		s.pending ??= s.fill()
			.then((cards) => { s.queue.push(...cards.filter((c) => !seen.has(c.id))); s.fails = 0; })
			.catch(() => { s.fails++; })
			.finally(() => { s.pending = undefined; });
		return s.pending;
	}

	// ---- weights ------------------------------------------------------------

	const sliders = [...document.querySelectorAll<HTMLInputElement>('#tune input[data-src]')];
	const chapterInput = document.getElementById('chapterLen') as HTMLInputElement;
	const savedWeights = load<Record<string, number>>(W_KEY, {});
	for (const s of sliders) if (savedWeights[s.dataset.src!] != null) s.value = String(savedWeights[s.dataset.src!]);
	if (savedWeights.chapter) chapterInput.value = String(savedWeights.chapter);
	const weights = () => Object.fromEntries(sliders.map((s) => [s.dataset.src!, +s.value]));
	function syncOutputs() {
		for (const s of [...sliders, chapterInput]) {
			document.querySelector(`output[data-for="${s.dataset.src ?? 'chapter'}"]`)!.textContent = s.value;
		}
	}
	function saveWeights() { store(W_KEY, { ...weights(), chapter: +chapterInput.value }); syncOutputs(); }
	for (const s of [...sliders, chapterInput]) s.addEventListener('input', saveWeights);
	document.getElementById('forgetSeen')!.addEventListener('click', (e) => {
		seen.clear(); remember();
		(e.target as HTMLButtonElement).textContent = 'forgotten';
	});
	document.getElementById('resetTune')!.addEventListener('click', () => {
		for (const s of sliders) s.value = s.dataset.default!;
		chapterInput.value = '25';
		saveWeights();
	});
	syncOutputs();

	function choose(exclude: Set<string>) {
		const w = weights();
		const live = Object.entries(w).filter(([id, v]) => v > 0 && !exclude.has(id) && SOURCES[id].fails < 3);
		const total = live.reduce((n, [, v]) => n + v, 0);
		if (!total) return null;
		let r = Math.random() * total;
		for (const [id, v] of live) if ((r -= v) < 0) return { id, why: `drawn at random from ${SOURCES[id].name}: weight ${v} of ${total} (${Math.round((v / total) * 100)}%)` };
		return null;
	}

	async function nextCard(): Promise<[Card, string] | null> {
		const tried = new Set<string>();
		for (;;) {
			const c = choose(tried);
			if (!c) return null;
			const s = SOURCES[c.id];
			if (s.queue.length < 3) refill(c.id);
			if (!s.queue.length) {
				// don't stall the feed on a slow source: try another one that's ready
				const ready = Object.keys(SOURCES).some((id) => id !== c.id && weights()[id] > 0 && SOURCES[id].queue.length);
				if (ready) { tried.add(c.id); continue; }
				// nothing ready yet: wait for whichever source answers first, not just this one
				const pending = Object.values(SOURCES).map((x) => x.pending).filter(Boolean);
				await (pending.length ? Promise.race(pending) : refill(c.id));
				if (!s.queue.length) continue;
			}
			const card = s.queue.shift();
			if (card && !seen.has(card.id)) return [card, c.why];
			if (!s.queue.length) tried.add(c.id);
		}
	}

	// ---- rendering ----------------------------------------------------------

	const stream = document.getElementById('stream')!;
	// every card you've been shown, across visits, so the feed doesn't repeat itself
	const SEEN_KEY = 'aishipped.feed.seen';
	const seen = new Set<string>(load<string[]>(SEEN_KEY, []));
	const remember = () => store(SEEN_KEY, [...seen].slice(-20000));
	let saved = load<{ id: string; title: string; link: string; src: string }[]>(S_KEY, []);
	let shown = 0;
	let chapter = 1;
	let sinceBreak = 0;
	const t0 = Date.now();

	const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, txt?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (txt != null) e.textContent = txt;
		return e;
	};
	const link = (href: string, label: string) => {
		const a = el('a', '', label);
		a.href = href; a.target = '_blank'; a.rel = 'noopener';
		return a;
	};

	function render(card: Card, why: string) {
		seen.add(card.id);
		const art = el('article', `card src-${card.src}`);
		art.dataset.id = card.id;
		art.tabIndex = -1;
		art.append(el('p', 'why', why));

		if (card.img) {
			const fig = el('figure');
			if (card.placeholder) fig.style.backgroundImage = `url("${card.placeholder}")`;
			const img = el('img');
			img.src = card.img; img.alt = card.imgAlt ?? ''; img.loading = shown < 3 ? 'eager' : 'lazy';
			if (shown < 2) img.fetchPriority = 'high'; img.decoding = 'async';
			img.referrerPolicy = 'no-referrer';
			img.onload = () => fig.classList.add('loaded');
			img.onerror = () => fig.remove();
			fig.append(img);
			art.append(fig);
		}
		if (card.embed) {
			const fig = art.querySelector('figure');
			if (fig) {
				fig.classList.add('play');
				fig.addEventListener('click', () => {
					const f = el('iframe');
					f.src = card.embed!; f.allow = 'autoplay; fullscreen'; f.allowFullscreen = true;
					fig.replaceChildren(f);
				}, { once: true });
			}
		}
		if (card.draw) {
			const cv = el('canvas');
			card.draw(cv);
			art.append(cv);
		}
		art.append(el('h3', '', card.title));
		if (card.sub) art.append(el('p', 'sub', card.sub));
		if (card.body) {
			const b = el('p', card.verse ? 'body verse' : 'body', card.body);
			b.addEventListener('click', () => b.classList.toggle('open'));
			art.append(b);
			requestAnimationFrame(() => { if (b.scrollHeight > b.clientHeight + 4) b.classList.add('clamped'); });
		}

		const foot = el('p', 'foot');
		foot.append(link(card.link, `open on ${card.linkText ?? 'source'} ↗`));
		if (card.extra) foot.append(link(card.extra[0], `${card.extra[1]} ↗`));
		const star = el('button', 'save', isSaved(card.id) ? '★ saved' : '☆ save');
		star.addEventListener('click', () => toggleSave(card, star));
		foot.append(star);
		if (card.more) {
			const more = el('button', 'more', '↳ more like this');
			more.addEventListener('click', async () => {
				more.disabled = true; more.textContent = '↳ finding…';
				try {
					const cards = (await card.more!()).filter((c) => !seen.has(c.id));
					let after: Element = art;
					for (const c of cards) {
						const n = render(c, `you asked for more like "${card.title.slice(0, 60)}"`);
						n.classList.add('child');
						after.after(n); after = n;
					}
					more.textContent = cards.length ? `↳ ${cards.length} added below` : '↳ nothing more found';
				} catch { more.textContent = '↳ source didn’t answer'; more.disabled = false; }
			});
			foot.append(more);
		}
		art.append(foot);
		if (card.credit) art.append(el('p', 'credit', card.credit));
		return art;
	}

	function chapterBreak() {
		const mins = Math.round((Date.now() - t0) / 60000);
		const d = el('div', 'chapter');
		d.append(
			el('p', 'big', `end of chapter ${chapter}`),
			el('p', '', `${shown} cards · ${mins} min here. A good place to stop. Or keep going: chapter ${chapter + 1} is below.`),
		);
		chapter++;
		return d;
	}

	let busy = false;
	async function more(n = 8) {
		if (busy) return;
		busy = true;
		const sentinel = document.getElementById('sentinel')!;
		sentinel.textContent = 'loading…';
		// start the whole batch at once so slow sources load in parallel; show each as soon as it's ready
		const batch = Array.from({ length: n }, () => nextCard());
		for (const pending of batch) {
			const next = await pending;
			if (!next) { sentinel.textContent = 'every source is off or not answering. press tune.'; break; }
			stream.append(render(...next));
			shown++; sinceBreak++;
			document.getElementById('count')!.textContent = String(shown);
			if (sinceBreak >= +chapterInput.value) { stream.append(chapterBreak()); sinceBreak = 0; }
		}
		busy = false;
		remember();
		if (nearBottom()) more();
	}
	const nearBottom = () => document.getElementById('sentinel')!.getBoundingClientRect().top < innerHeight * 4;
	new IntersectionObserver((e) => { if (e[0].isIntersecting) more(); }, { rootMargin: '3000px 0px' })
		.observe(document.getElementById('sentinel')!);

	setInterval(() => {
		const m = Math.floor((Date.now() - t0) / 60000);
		document.getElementById('clock')!.textContent = m < 60 ? `${m} min` : `${Math.floor(m / 60)} h ${m % 60} min`;
	}, 15000);

	// ---- saves --------------------------------------------------------------

	const isSaved = (id: string) => saved.some((s) => s.id === id);
	function toggleSave(card: Card, btn: HTMLButtonElement) {
		if (isSaved(card.id)) saved = saved.filter((s) => s.id !== card.id);
		else saved.unshift({ id: card.id, title: card.title, link: card.link, src: SOURCES[card.src]?.name ?? card.src });
		store(S_KEY, saved);
		btn.textContent = isSaved(card.id) ? '★ saved' : '☆ save';
		renderSaved();
	}
	function renderSaved() {
		document.getElementById('savedCount')!.textContent = String(saved.length);
		const ul = document.getElementById('savedList')!;
		ul.replaceChildren(...saved.map((s) => {
			const li = el('li');
			li.append(link(s.link, s.title), el('span', 'src', ` ${s.src}`));
			const x = el('button', 'x', '×');
			x.setAttribute('aria-label', 'remove');
			x.addEventListener('click', () => {
				saved = saved.filter((v) => v.id !== s.id);
				store(S_KEY, saved);
				const b = stream.querySelector(`[data-id="${CSS.escape(s.id)}"] .save`);
				if (b) b.textContent = '☆ save';
				renderSaved();
			});
			li.append(x);
			return li;
		}));
		if (!saved.length) ul.append(el('li', 'src', 'nothing yet. press ☆ on a card.'));
	}
	document.getElementById('exportSaved')!.addEventListener('click', (e) => {
		navigator.clipboard?.writeText(saved.map((s) => `${s.title}\n${s.link}`).join('\n\n'));
		(e.target as HTMLButtonElement).textContent = 'copied';
	});
	renderSaved();

	// ---- panels & keys ------------------------------------------------------

	function toggle(id: string, force?: boolean) {
		for (const p of document.querySelectorAll<HTMLElement>('.panel')) {
			const open = p.id === id ? (force ?? p.hidden) : false;
			p.hidden = !open;
			document.querySelector(`[aria-controls="${p.id}"]`)?.setAttribute('aria-expanded', String(open));
		}
	}
	document.getElementById('tuneBtn')!.addEventListener('click', () => toggle('tune'));
	document.getElementById('savedBtn')!.addEventListener('click', () => toggle('saved'));
	for (const b of document.querySelectorAll('[data-close]')) b.addEventListener('click', () => toggle('', false));

	function current() {
		const cards = [...stream.querySelectorAll<HTMLElement>('.card')];
		const top = 70;
		return { cards, i: cards.findIndex((c) => c.getBoundingClientRect().bottom > top + 40) };
	}
	addEventListener('keydown', (e) => {
		if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
		const { cards, i } = current();
		const go = (n: number) => { const c = cards[Math.max(0, Math.min(cards.length - 1, n))]; c?.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
		if (e.key === 'j') go(cards[i] && cards[i].getBoundingClientRect().top > 80 ? i : i + 1);
		else if (e.key === 'k') go(i - 1);
		else if (e.key === 's') cards[i]?.querySelector<HTMLButtonElement>('.save')?.click();
		else if (e.key === 'm') cards[i]?.querySelector<HTMLButtonElement>('.more:not(:disabled)')?.click();
		else if (e.key === 'Escape') toggle('', false);
	});

	// leftover cards from last visit make the first screen instant
	const C_KEY = 'aishipped.feed.cache';
	for (const c of shuffle(load<Card[]>(C_KEY, []))) if (!seen.has(c.id)) SOURCES[c.src]?.queue.push(c);
	store(C_KEY, []);
	const saveLeftovers = () => {
		const left = Object.values(SOURCES).flatMap((x) => x.queue.filter((c) => !c.draw).slice(0, 4))
			.map(({ more, draw, ...c }) => c);
		store(C_KEY, left);
		remember();
	};
	addEventListener('pagehide', saveLeftovers);
	document.addEventListener('visibilitychange', () => { if (document.hidden) saveLeftovers(); });

	navigator.serviceWorker?.register('/sw.js').catch(() => {});
	for (const id of Object.keys(SOURCES)) if (weights()[id] > 0) refill(id);
	more(10);
</script>

