	});
	syncOutputs();

	function choose(exclude: Set<string>) {
		if (packOn()) return exclude.has('pack') || SOURCES.pack.fails >= 3 ? null : { id: 'pack', why: 'from your pack: a card you kept, drawn at random' };
		const w = weights();
		const live = Object.entries(w).filter(([id, v]) => v > 0 && enabled(id) && !exclude.has(id) && SOURCES[id].fails < 3);
		const total = live.reduce((n, [, v]) => n + v, 0);
		if (!total) return null;
		let r = rnd() * total;
		for (const [id, v] of live) if ((r -= v) < 0) return { id, why: `${isRaw() && RAW[id] ? 'uncurated: a random item from all of' : 'drawn at random from'} ${SOURCES[id].name}: weight ${v} of ${total} (${Math.round((v / total) * 100)}%)` };
		return null;
	}

	async function nextCard(): Promise<[Card, string] | null> {
		const tried = new Set<string>();
		for (;;) {
			const c = choose(tried);
			if (!c) return null;
			const s = SOURCES[c.id];
			if (SEED !== null) {
				// seeded: one source at a time, and wait for it, so timing never changes what comes next
				if (!s.queue.length) await refill(c.id);
				s.queue = s.queue.filter((x) => !blocked(x));
				if (!s.queue.length) { tried.add(c.id); continue; }
				return [s.queue.shift()!, c.why];
			}
			if (s.queue.length < 3) refill(c.id);
			if (!s.queue.length) {
				// don't stall the feed on a slow source: try another one that's ready
				const ready = Object.keys(SOURCES).some((id) => id !== c.id && weights()[id] > 0 && enabled(id) && SOURCES[id].queue.length);
				if (ready) { tried.add(c.id); continue; }
				// nothing ready yet: wait for whichever source answers first, not just this one
				const pending = Object.values(SOURCES).map((x) => x.pending).filter(Boolean);
				await (pending.length ? Promise.race(pending) : refill(c.id));
				if (!s.queue.length) continue;
			}
			// taste: look at the next few cards waiting in this source and take the closest; strength 0 takes the first
			s.queue = s.queue.filter((x) => !seen.has(x.id) && !blocked(x));
			if (!s.queue.length) { tried.add(c.id); continue; }
			// several cards are being picked at once, so claim the chosen card by identity after scoring
			const pickT = await tastePick(s.queue);
			const at = pickT.card ? s.queue.indexOf(pickT.card) : -1;
			if (at < 0) continue;
			const card = s.queue.splice(at, 1)[0];
			if (!seen.has(card.id)) { taken.set(card.id, pickT); return [card, pickT.why ? `${c.why} · ${pickT.why}` : c.why]; }
			if (!s.queue.length) tried.add(c.id);
		}
	}

	// ---- your taste (runs here, or on your own computer) ---------------------

	const T_KEY = 'aishipped.feed.taste';
	const LOG_KEY = 'aishipped.feed.log';
	type Taste = { want: string; less: string; strength: number; saves: boolean; ollama: boolean; model: string };
	const tasteDefault: Taste = { want: '', less: '', strength: 0, saves: true, ollama: false, model: 'nomic-embed-text' };
	let taste: Taste = { ...tasteDefault, ...load<Partial<Taste>>(T_KEY, {}) };
	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const tWant = $<HTMLTextAreaElement>('tasteWant'), tLess = $<HTMLTextAreaElement>('tasteLess');
	const tStrength = $<HTMLInputElement>('tasteStrength'), tSaves = $<HTMLInputElement>('tasteSaves');
	const tOllama = $<HTMLInputElement>('tasteOllama'), tModel = $<HTMLInputElement>('tasteModel'), tStatus = $('tasteStatus');
	const showTaste = () => {
		tWant.value = taste.want; tLess.value = taste.less; tStrength.value = String(taste.strength);
		tSaves.checked = taste.saves; tOllama.checked = taste.ollama; tModel.value = taste.model;
		document.querySelector('output[data-for="tasteStrength"]')!.textContent = String(taste.strength);
	};
	const saveTaste = () => {
		taste = { want: tWant.value, less: tLess.value, strength: +tStrength.value, saves: tSaves.checked, ollama: tOllama.checked, model: tModel.value.trim() || 'nomic-embed-text' };
		store(T_KEY, taste); showTaste(); profileVecs = null;
		if (taste.ollama) checkOllama();
	};
	showTaste();
	for (const x of [tWant, tLess, tModel]) x.addEventListener('change', saveTaste);
	for (const x of [tStrength, tSaves, tOllama]) x.addEventListener('input', saveTaste);

	const cardText = (c: Card) => [c.title, c.sub, c.body?.slice(0, 500), c.imgAlt].filter(Boolean).join('. ');
	const lines = (t: string) => t.split('\n').map((x) => x.trim()).filter((x) => x && !x.startsWith('#'));
	// the profile: what you wrote, plus your saves if you allow it
	const wants = () => [...lines(taste.want).map((t) => ({ t, label: t })), ...(taste.saves ? saved.slice(0, 60).map((x) => ({ t: x.text || x.title, label: `your save "${x.title.slice(0, 40)}"` })) : [])];
	const lesses = () => lines(taste.less).map((t) => ({ t, label: t }));

	// --- word matching: always available, nothing leaves the page
	const STOP = new Set('the a an and or of in on at to for with from by is are was were be this that it its as into over under old new'.split(' '));
	// "birds" and "bird" count as the same word, like the never-show list
	const stem = (w: string) => w.length < 4 ? w : w.replace(/ies$/, 'y').replace(/(ss|x|ch|sh)es$/, '$1').replace(/([^s])s$/, '$1');
	const toks = (t: string) => (t.toLowerCase().match(/[\p{L}\p{N}]+/gu) ?? []).filter((w) => w.length > 2 && !STOP.has(w)).map(stem);
	function wordScore(c: Card) {
		const have = new Set(toks(cardText(c)));
		const hit = (t: string) => { const w = toks(t); return w.length ? w.filter((x) => have.has(x)).length / w.length : 0; };
		let best = { s: 0, label: '' }, worst = { s: 0, label: '' };
		for (const x of wants()) { const s = hit(x.t); if (s > best.s) best = { s, label: x.label }; }
		for (const x of lesses()) { const s = hit(x.t); if (s > worst.s) worst = { s, label: x.label }; }
		return { score: best.s - worst.s, best, worst };
	}

	// --- meaning matching: Ollama on this computer
	const OLLAMA = 'http://localhost:11434';
	let ollamaOk = false;
	const vecCache = new Map<string, number[]>();
	let profileVecs: { want: { v: number[]; label: string }[]; less: { v: number[]; label: string }[] } | null = null;
	async function embed(texts: string[]): Promise<number[][]> {
		const need = [...new Set(texts.filter((t) => !vecCache.has(t)))];
		if (need.length) {
			const r = await fetch(`${OLLAMA}/api/embed`, { method: 'POST', body: JSON.stringify({ model: taste.model, input: need }), signal: AbortSignal.timeout(20000) });
			if (!r.ok) throw new Error(`ollama ${r.status}`);
			const d = await r.json();
			need.forEach((t, i) => vecCache.set(t, d.embeddings[i]));
			if (vecCache.size > 3000) for (const k of [...vecCache.keys()].slice(0, 1000)) vecCache.delete(k);
		}
		return texts.map((t) => vecCache.get(t)!);
	}
	const cos = (a: number[], b: number[]) => { let d = 0, x = 0, y = 0; for (let i = 0; i < a.length; i++) { d += a[i] * b[i]; x += a[i] * a[i]; y += b[i] * b[i]; } return d / (Math.sqrt(x * y) || 1); };
	async function checkOllama() {
		tStatus.textContent = ' checking for ollama…';
		try {
			await embed(['test']);
			ollamaOk = true; tStatus.textContent = ` connected: ${taste.model} is running on this computer.`;
		} catch {
			ollamaOk = false; tStatus.textContent = ` not reachable, so matching by words instead. Is Ollama running, does its OLLAMA_ORIGINS include ${location.origin}, and is ${taste.model} pulled?`;
		}
	}
	if (taste.ollama) checkOllama();
	const LESS_BAR = 0.6; // with nothing under "more of this": how alike a card must be to a "less" line to be lowered
	async function meaningScores(cards: Card[]) {
		if (!profileVecs) {
			const w = wants(), l = lesses();
			const [wv, lv] = await Promise.all([embed(w.map((x) => x.t)), embed(l.map((x) => x.t))]);
			profileVecs = { want: wv.map((v, i) => ({ v, label: w[i].label })), less: lv.map((v, i) => ({ v, label: l[i].label })) };
		}
		const cv = await embed(cards.map(cardText));
		return cv.map((v) => {
			let best = { s: 0, label: '' }, worst = { s: 0, label: '' };
			for (const x of profileVecs!.want) { const s = cos(v, x.v); if (s > best.s) best = { s, label: x.label }; }
			for (const x of profileVecs!.less) { const s = cos(v, x.v); if (s > worst.s) worst = { s, label: x.label }; }
			// the model finds every pair of texts a little alike, so a "less" line only counts (and is only
			// named) when the card is closer to it than to anything in "more of this"
			const over = profileVecs!.want.length ? worst.s - best.s : worst.s - LESS_BAR;
			const lowered = over > 0 ? { s: over, label: worst.label } : { s: 0, label: '' };
			return { score: best.s - lowered.s, best, worst: lowered };
		});
	}

	type Pick = { card?: Card; why: string; score?: number; method?: string; compared?: number };
	const taken = new Map<string, Pick>();
	async function tastePick(queue: Card[]): Promise<Pick> {
		if (!taste.strength || (!wants().length && !lesses().length)) return { card: queue[0], why: '' };
		const pool = queue.slice(0, 1 + taste.strength * 2);
		let scores: ReturnType<typeof wordScore>[], method = 'word match';
		try {
			if (!taste.ollama || !ollamaOk) throw 0;
			scores = await meaningScores(pool); method = `${taste.model} on your computer`;
		} catch { scores = pool.map(wordScore); }
		let i = 0;
		scores.forEach((x, j) => { if (x.score > scores[i].score) i = j; });
		const x = scores[i];
		const bits = [`your taste: best of ${pool.length} waiting (${method}), score ${x.score.toFixed(2)}`];
		if (x.best.label && x.best.s > 0) bits.push(`closest to "${x.best.label}"`);
		if (x.worst.label && x.worst.s > 0.0001) bits.push(`lowered by "${x.worst.label}"`);
		return { card: pool[i], why: bits.join(', '), score: +x.score.toFixed(3), method, compared: pool.length };
	}

	// --- delivery log: everything shown, so you can check it
	let deliveries = load<any[]>(LOG_KEY, []);
	function logDelivery(card: Card, why: string) {
		const t = taken.get(card.id); taken.delete(card.id);
		deliveries.push({ at: new Date().toISOString(), id: card.id, source: SOURCES[card.src]?.name ?? card.src, title: card.title, link: card.link, image: card.img ?? null, why, taste: t?.score ?? null, method: t?.method ?? null });
		if (deliveries.length > 3000) deliveries = deliveries.slice(-3000);
		if (deliveries.length % 5 === 0) store(LOG_KEY, deliveries);
	}
	addEventListener('pagehide', () => store(LOG_KEY, deliveries));
	// every server contacted: counted as requests happen, because the browser's own list stops at 250 entries
	const hosts: Record<string, number> = {};
	const countHosts = (es: PerformanceEntryList) => { for (const e of es) { try { const h = new URL(e.name).host; hosts[h] = (hosts[h] ?? 0) + 1; } catch {} } };
	try { new PerformanceObserver((l) => countHosts(l.getEntries())).observe({ type: 'resource', buffered: true }); }
	catch { countHosts(performance.getEntriesByType('resource')); }
	performance.setResourceTimingBufferSize?.(100000);
	const download = (name: string, data: unknown) => {
		const a = document.createElement('a');
		a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
		a.download = name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 5000);
	};
	$('logExport').addEventListener('click', () => {
		store(LOG_KEY, deliveries);
		download(`aishipped-delivery-log-${new Date().toISOString().slice(0, 10)}.json`, {
			about: 'Every card shown on this device, newest last, and every server this page contacted since it was opened. Made in your browser; not sent anywhere.',
			settings: { weights: weights(), blocklistLines: lines(blockBox.value).length, taste: { ...taste, savesUsed: taste.saves ? Math.min(saved.length, 60) : 0 } },
			serversContactedThisVisit: Object.fromEntries(Object.entries(hosts).sort((a, b) => b[1] - a[1])),
			deliveries,
		});
	});
	$('tasteExport').addEventListener('click', () => download('aishipped-taste.json', { ...taste, saved }));
	$('tasteImport').addEventListener('click', () => {
		const f = document.createElement('input'); f.type = 'file'; f.accept = 'application/json,.json';
		f.onchange = async () => {
			try {
				const d = JSON.parse(await f.files![0].text());
				taste = { ...tasteDefault, ...Object.fromEntries(Object.entries(d).filter(([k]) => k in tasteDefault)) } as Taste;
				if (Array.isArray(d.saved)) { saved = d.saved.filter((x: any) => x && x.id && x.title && x.link); store(S_KEY, saved); renderSaved(); }
				store(T_KEY, taste); showTaste(); profileVecs = null; if (taste.ollama) checkOllama();
			} catch { tStatus.textContent = ' that file is not a profile from this page.'; }
		};
		f.click();
	});

	// ---- rendering ----------------------------------------------------------

	const stream = document.getElementById('stream')!;
	// every card you've been shown, across visits, so the feed doesn't repeat itself
	const SEEN_KEY = 'aishipped.feed.seen';
	const seen = new Set<string>(load<string[]>(SEEN_KEY, []));
	const remember = () => store(SEEN_KEY, [...seen].slice(-20000));
	let saved = load<{ id: string; title: string; link: string; src: string; text?: string }[]>(S_KEY, []);
	let shown = 0;
	let chapter = 1;
	const t0 = Date.now();

	const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, txt?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (txt != null) e.textContent = txt;
		return e;
	};
	const link = (href: string, label: string) => {
		const a = el('a', '', label);
		a.href = href; a.target = '_blank'; a.rel = 'noopener';
		return a;
	};

	function render(card: Card, why: string) {
		seen.add(card.id);
		logDelivery(card, why);
		const art = el('article', `card src-${card.src}`);
		art.dataset.id = card.id;
		art.dataset.blockText = [card.title, card.sub, card.body, card.imgAlt, card.credit].filter(Boolean).join(' \n ');
		art.tabIndex = -1;
		const w = el('details', 'why');
		w.append(el('summary', '', 'why am I seeing this?'), el('p', '', why));
		art.append(w);

		if (card.img) {
			const fig = el('figure');
			if (card.placeholder) fig.style.backgroundImage = `url("${pic(card.placeholder)}")`;
			const img = el('img');
			img.src = pic(card.img)!; img.alt = card.imgAlt ?? ''; img.loading = shown < 3 ? 'eager' : 'lazy';
			if (shown < 2) img.fetchPriority = 'high'; img.decoding = 'async';
			img.referrerPolicy = 'no-referrer';
			img.onload = () => fig.classList.add('loaded');
			img.onerror = () => {
				// a film or record still plays without its thumbnail: keep a plain play button
				if (card.embed) { img.remove(); fig.classList.add('noimg', 'loaded'); return; }
				// a picture card with nothing much else to it is useless without the picture
				if ((card.body?.length ?? 0) < 120) { art.remove(); return; }
				fig.remove();
			};
			fig.append(img);
			art.append(fig);
		}
		if (card.embed) {
			// films and records open on archive.org itself: no embedded player, so archive.org can't set
			// cookies or see you on this page unless you choose to go there
			const fig = art.querySelector('figure');
			if (fig) {
				fig.classList.add('play');
				const a = link(card.link, '');
				a.className = 'playlink'; a.setAttribute('aria-label', `play on archive.org: ${card.title}`);
				fig.append(a);
			}
		}
		if (card.draw) {
			const cv = el('canvas');
			card.draw(cv);
			art.append(cv);
		}
		art.append(el('h3', '', card.title));
		if (card.sub) art.append(el('p', 'sub', card.sub));
		if (card.body) {
			const b = el('p', card.verse ? 'body verse' : 'body', card.body);
			b.addEventListener('click', () => b.classList.toggle('open'));
			art.append(b);
			requestAnimationFrame(() => { if (b.scrollHeight > b.clientHeight + 4) b.classList.add('clamped'); });
		}

		const foot = el('p', 'foot');
		foot.append(link(card.link, `open on ${card.linkText ?? 'source'} ↗`));
		if (card.extra) foot.append(link(card.extra[0], `${card.extra[1]} ↗`));
		const star = el('button', 'save', isSaved(card.id) ? '★ saved' : '☆ save');
		star.addEventListener('click', () => toggleSave(card, star));
		foot.append(star);
		if (card.more && !privateMode) {
			const more = el('button', 'more', '↳ more like this');
			more.addEventListener('click', async () => {
				more.disabled = true; more.textContent = '↳ finding…';
				try {
					const cards = (await card.more!()).filter((c) => !seen.has(c.id) && !blocked(c));
					const asked = `you pressed "more like this" on "${card.title.slice(0, 60)}"`;
					if (order !== 'drawn') {
						// sorted modes: they join the next chapter and take their place in its order
						for (const c of cards) carry.push([c, asked]);
						more.textContent = cards.length ? `↳ ${cards.length} will be in the next chapter` : '↳ nothing more found';
						return;
					}
					let after: Element = art;
					for (const c of cards) {
						const n = render(c, `${asked} · placed directly under it`);
						n.classList.add('child');
						after.after(n); after = n;
					}
					more.textContent = cards.length ? `↳ ${cards.length} added below` : '↳ nothing more found';
				} catch { more.textContent = '↳ source didn’t answer'; more.disabled = false; }
			});
			foot.append(more);
		}
		art.append(foot);
		if (card.credit) art.append(el('p', 'credit', card.credit));
		if (card.src === 'pack') {
			// your pack, captions off: the picture and its title, and the rest when you tap
			art.classList.toggle('quiet', !capBox.checked);
			art.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a, button, details, figure')) art.classList.remove('quiet'); });
		}
		return art;
	}

	function chapterBreak(partial = 0) {
		const mins = Math.round((Date.now() - t0) / 60000);
		const d = el('div', 'chapter');
		d.append(
			el('p', 'big', `end of chapter ${chapter}`),
			...(partial ? [el('p', '', `partial chapter: only ${partial} of ${+chapterInput.value} cards arrived before the sources stopped answering.`)] : []),
			el('p', '', `${shown} cards · ${mins} min here. A good place to stop. Or keep going: chapter ${chapter + 1} is below.`),
		);
		chapter++;
		return d;
	}

	// Three ways to order (the buttons at the top):
	//  as drawn: each card appears the moment it's picked, in that order
	//  A–Z: a chapter's cards are gathered first, then sorted by title, with a letter heading wherever the first
	//       letter changes. Titles starting with a number come after Z (under "0–9"), then other scripts and
	//       symbols (under "#"). "The" and "A" count like any other word.
	//  shuffle: gathered the same way, then put in an order drawn from the seed shown above the feed
	const sortKey = (c: Card) => (c.title ?? '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/^[^\p{L}\p{N}]+/u, '').toLowerCase();
	const letterOf = (k: string) => (/^[a-z]/.test(k) ? k[0].toUpperCase() : /^[0-9]/.test(k) ? '0–9' : '#');
	const rank = (L: string) => (L === '0–9' ? 1 : L === '#' ? 2 : 0);
	const byTitle = (a: Card, b: Card) => {
		const ka = sortKey(a), kb = sortKey(b);
		return rank(letterOf(ka)) - rank(letterOf(kb)) || ka.localeCompare(kb, 'en', { sensitivity: 'base', numeric: true });
	};
	const cut = (t: string) => (t.length > 50 ? t.slice(0, 50) + '…' : t);
	const seedNote = () => (SEED !== null ? ` · seed ${SEED}` : '');
	let inFlight = 0;
	const batch: [Card, string][] = [];
	const carry: [Card, string][] = []; // "more like this" cards waiting for the next chapter
	function flush(partial = false) {
		const want = +chapterInput.value;
		const cards = [...batch.splice(0), ...carry.splice(0)];
		const n = cards.length;
		let pos: string[];
		if (order === 'az') {
			cards.sort((x, y) => byTitle(x[0], y[0]));
			pos = cards.map(([c], i) => {
				const prev = cards[i - 1]?.[0], next = cards[i + 1]?.[0];
				return `placed A to Z by its title "${cut(c.title)}"${prev ? `, after "${cut(prev.title)}"` : ', first in the chapter'}${next ? `, before "${cut(next.title)}"` : ', last in the chapter'}`;
			});
		} else {
			// shuffle with this chapter's own random numbers from the seed, so earlier chapters never shift later ones
			const r = mulberry((SEED ?? 0) * 7919 + chapter);
			for (let i = n - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [cards[i], cards[j]] = [cards[j], cards[i]]; }
			pos = cards.map(() => `placed by shuffling the chapter with seed ${SEED} (chapter ${chapter})`);
		}
		let last = '';
		cards.forEach(([card, why], i) => {
			const L = letterOf(sortKey(card));
			if (order === 'az' && L !== last) { stream.append(el('div', 'letter', L)); last = L; }
			stream.append(render(card, `chapter ${chapter}, card ${i + 1} of ${n} · ${pos[i]} · picked because: ${why}${card.batch ? ` · ${card.batch}` : ''}${seedNote()}`));
			shown++;
		});
		document.getElementById('count')!.textContent = String(shown);
		stream.append(chapterBreak(partial && n < want ? n : 0));
		remember();
		if (nearBottom()) more();
	}
	let sinceBreak = 0;
	function more(n = SEED !== null ? 1 : 8) {
		const sentinel = document.getElementById('sentinel')!;
		const want = +chapterInput.value;
		if (order !== 'drawn') sentinel.textContent = `gathering chapter ${chapter}: ${batch.length} of ${want} cards, then ${order === 'az' ? 'A to Z' : `shuffled with seed ${SEED}`}…`;
		else sentinel.textContent = 'loading…';
		for (; inFlight < n && (order === 'drawn' || batch.length + inFlight < want); inFlight++) {
			nextCard().then((next) => {
				inFlight--;
				if (!next) {
					// sources ran dry: show what we have rather than wait forever
					if (order !== 'drawn' && !inFlight && batch.length) flush(true);
					else if (!shown && !batch.length && !inFlight) sentinel.textContent = 'every source is off or not answering. press tune.';
					return;
				}
				if (order === 'drawn') {
					sinceBreak++;
					stream.append(render(next[0], `chapter ${chapter}, card ${sinceBreak} · placed as drawn: the ${sinceBreak}${['th', 'st', 'nd', 'rd'][sinceBreak % 10 < 4 && Math.floor(sinceBreak / 10) % 10 !== 1 ? sinceBreak % 10 : 0]} card picked for this chapter · picked because: ${next[1]}${next[0].batch ? ` · ${next[0].batch}` : ''}${seedNote()}`));
					shown++;
					document.getElementById('count')!.textContent = String(shown);
					if (sinceBreak >= want) { stream.append(chapterBreak()); sinceBreak = 0; }
					if (shown % 8 === 0) remember();
					if (nearBottom()) more();
					return;
				}
				if (!batch.some(([c]) => c.id === next[0].id)) batch.push(next);
				if (batch.length >= +chapterInput.value) flush();
				else more(n);
			});
		}
	}
	const nearBottom = () => document.getElementById('sentinel')!.getBoundingClientRect().top < innerHeight * 4;
	new IntersectionObserver((e) => { if (e[0].isIntersecting) more(); }, { rootMargin: '3000px 0px' })
		.observe(document.getElementById('sentinel')!);

	setInterval(() => {
		const m = Math.floor((Date.now() - t0) / 60000);
		document.getElementById('clock')!.textContent = m < 60 ? `${m} min` : `${Math.floor(m / 60)} h ${m % 60} min`;
	}, 15000);

	// ---- saves --------------------------------------------------------------

	const isSaved = (id: string) => saved.some((s) => s.id === id);
	function toggleSave(card: Card, btn: HTMLButtonElement) {
		if (isSaved(card.id)) saved = saved.filter((s) => s.id !== card.id);
		else saved.unshift({ id: card.id, title: card.title, link: card.link, src: SOURCES[card.src]?.name ?? card.src, text: cardText(card).slice(0, 600) });
		store(S_KEY, saved);
		btn.textContent = isSaved(card.id) ? '★ saved' : '☆ save';
		renderSaved();
	}
	function renderSaved() {
		document.getElementById('savedCount')!.textContent = String(saved.length);
		const ul = document.getElementById('savedList')!;
		ul.replaceChildren(...saved.map((s) => {
			const li = el('li');
			li.append(link(s.link, s.title), el('span', 'src', ` ${s.src}`));
			const x = el('button', 'x', '×');
			x.setAttribute('aria-label', 'remove');
			x.addEventListener('click', () => {
				saved = saved.filter((v) => v.id !== s.id);
				store(S_KEY, saved);
				const b = stream.querySelector(`[data-id="${CSS.escape(s.id)}"] .save`);
				if (b) b.textContent = '☆ save';
				renderSaved();
			});
			li.append(x);
			return li;
		}));
		if (!saved.length) ul.append(el('li', 'src', 'nothing yet. press ☆ on a card.'));
	}
	document.getElementById('exportSaved')!.addEventListener('click', (e) => {
		navigator.clipboard?.writeText(saved.map((s) => `${s.title}\n${s.link}`).join('\n\n'));
		(e.target as HTMLButtonElement).textContent = 'copied';
	});
	renderSaved();

	// ---- panels & keys ------------------------------------------------------

	function toggle(id: string, force?: boolean) {
		for (const p of document.querySelectorAll<HTMLElement>('.panel')) {
			const open = p.id === id ? (force ?? p.hidden) : false;
			p.hidden = !open;
			document.querySelector(`[aria-controls="${p.id}"]`)?.setAttribute('aria-expanded', String(open));
		}
	}
	document.getElementById('tuneBtn')!.addEventListener('click', () => toggle('tune'));
	document.getElementById('savedBtn')!.addEventListener('click', () => toggle('saved'));
	for (const b of document.querySelectorAll('[data-close]')) b.addEventListener('click', () => toggle('', false));

	function current() {
		const cards = [...stream.querySelectorAll<HTMLElement>('.card')];
		const top = 70;
		return { cards, i: cards.findIndex((c) => c.getBoundingClientRect().bottom > top + 40) };
	}
	addEventListener('keydown', (e) => {
		if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
		const { cards, i } = current();
		const go = (n: number) => { const c = cards[Math.max(0, Math.min(cards.length - 1, n))]; c?.scrollIntoView({ block: 'start' }); };
		if (e.key === 'j') go(cards[i] && cards[i].getBoundingClientRect().top > 80 ? i : i + 1);
		else if (e.key === 'k') go(i - 1);
		else if (e.key === 's') cards[i]?.querySelector<HTMLButtonElement>('.save')?.click();
		else if (e.key === 'm') cards[i]?.querySelector<HTMLButtonElement>('.more:not(:disabled)')?.click();
		else if (e.key === 'Escape') toggle('', false);
	});

	// leftover cards from last visit make the first screen instant
	const C_KEY = 'aishipped.feed.cache';
	if (!isRaw() && !fixedData) for (const c of shuffle(load<Card[]>(C_KEY, []))) if (!seen.has(c.id)) SOURCES[c.src]?.queue.push(c);
	store(C_KEY, []);
	const saveLeftovers = () => {
		const left = Object.values(SOURCES).flatMap((x) => x.queue.filter((c) => !c.draw).slice(0, 4))
			.map(({ more, draw, ...c }) => c);
		store(C_KEY, left);
		remember();
	};
	addEventListener('pagehide', saveLeftovers);
	document.addEventListener('visibilitychange', () => { if (document.hidden) saveLeftovers(); });

	navigator.serviceWorker?.register('/sw.js').catch(() => {});
	document.getElementById('tune')!.classList.toggle('raw', isRaw());
	if (SEED === null) for (const id of Object.keys(SOURCES)) if (weights()[id] > 0 && enabled(id)) refill(id);

	// ---- order buttons, seed line, private mode, forget everything ----
	const setURL = (p: Record<string, string | null>) => {
		const u = new URL(location.href);
		for (const [k, v] of Object.entries(p)) v === null ? u.searchParams.delete(k) : u.searchParams.set(k, v);
		location.href = u.toString();
	};
	for (const b of document.querySelectorAll<HTMLButtonElement>('.order [data-order]')) {
		b.classList.toggle('on', b.dataset.order === order);
		b.addEventListener('click', () => { store(ORDER_KEY, b.dataset.order); setURL({ order: SEED !== null ? b.dataset.order! : null }); });
	}
	const shuffleBtn = document.getElementById('shuffleBtn')!;
	shuffleBtn.classList.toggle('on', order === 'shuffle');
	shuffleBtn.addEventListener('click', () => setURL({ seed: String(1 + Math.floor(Math.random() * 999_999_999)), order: 'shuffle' }));
	if (SEED !== null) {
		const line = document.getElementById('seedLine')!;
		line.hidden = false;
		line.innerHTML = `seed <b>${SEED}</b> · ${order === 'shuffle' ? 'shuffled' : order === 'az' ? 'A to Z' : 'as drawn'} · cards from this site's weekly copy only (build <span id="buildId">…</span>) · the same link gives the same cards in the same order, as long as the sliders and never-show list match · <button id="copySeed">copy link</button> <button id="leaveSeed">leave seeded mode</button>`;
		fetch('/build.txt').then((r) => r.text()).then((t) => { document.getElementById('buildId')!.textContent = t.trim().slice(0, 7); }).catch(() => {});
		document.getElementById('copySeed')!.addEventListener('click', (e) => { navigator.clipboard?.writeText(location.href); (e.target as HTMLButtonElement).textContent = 'copied'; });
		document.getElementById('leaveSeed')!.addEventListener('click', () => setURL({ seed: null, order: null }));
	}
	const privBox = document.getElementById('private') as HTMLInputElement;
	privBox.checked = privateMode;
	privBox.addEventListener('change', () => { store(PRIV_KEY, privBox.checked); location.reload(); });
	document.getElementById('forgetAll')!.addEventListener('click', async () => {
		if (!confirm('Delete everything this site keeps in this browser?')) return;
		for (const k of Object.keys(localStorage)) if (k.startsWith('aishipped.')) localStorage.removeItem(k);
		try { for (const k of await caches.keys()) await caches.delete(k); } catch {}
		try { for (const r of (await navigator.serviceWorker?.getRegistrations()) ?? []) await r.unregister(); } catch {}
		removeEventListener('pagehide', saveLeftovers);
		location.href = '/feed';
	});
	more(SEED !== null ? 1 : 10);
</script>

