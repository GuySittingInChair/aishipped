	const SOURCES: Record<string, { name: string; fill: () => Promise<Card[]>; queue: Card[]; pending?: Promise<void>; fails: number; batches?: number }> = {};

	// ---- the Met ------------------------------------------------------------------
	function metCard(o: any): Card | null {
		if (!o?.isPublicDomain || !o.primaryImageSmall || !o.title) return null;
		return {
			id: `met:${o.objectID}`,
			src: 'met',
			title: o.title,
			sub: [o.artistDisplayName, o.objectDate, o.culture].filter(Boolean).join(' · '),
			body: [o.medium, o.department].filter(Boolean).join(' · '),
			img: o.primaryImageSmall,
			imgAlt: o.title,
			link: o.objectURL,
			linkText: 'metmuseum.org',
			credit: 'The Metropolitan Museum of Art · public domain',
			more: o.artistDisplayName ? async () => {
				const d = await getJSON(`https://collectionapi.metmuseum.org/public/collection/v1.1/search?${qs({ hasImages: true, artistOrCulture: true, q: o.artistDisplayName, limit: 40 })}`);
				return metObjects(shuffle((d.objectIDs ?? []).filter((x: number) => x !== o.objectID)).slice(0, 8), 3);
			} : undefined,
		};
	}
	async function metObjects(ids: number[], max = 99) {
		const got = await Promise.all(ids.map((id) => getJSON(`https://collectionapi.metmuseum.org/public/collection/v1/objects/${id}`, 12000).catch(() => null)));
		return got.map(metCard).filter(Boolean).slice(0, max) as Card[];
	}
	// the Met's own highlights: a few thousand objects its curators flag
	async function met() {
		const d = await getJSON(`https://collectionapi.metmuseum.org/public/collection/v1.1/search?${qs({ hasImages: true, isHighlight: true, q: '*', limit: 16, offset: rand(2500) })}`);
		return metObjects(d.objectIDs ?? []);
	}
