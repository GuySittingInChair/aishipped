		// page 1 always exists; deeper pages only for big topics
		const d = await relay('curious', WELLCOME_Q.length, `https://api.wellcomecollection.org/catalogue/v2/images?${qs({ query: q, pageSize: 20, page: 1 + rand(3), 'locations.license': 'pdm,cc-0,cc-by' })}`);
