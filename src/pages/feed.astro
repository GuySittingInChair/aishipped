---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

// snapshot counts are baked into the page so the first fetch needs no round trip
let snaps = '{}';
try { snaps = readFileSync('public/data/manifest.json', 'utf8'); } catch {}

// one batch per source baked into the HTML, so the first screen needs no requests at all. Which batch is
// chosen by the snapshot's contents, not chance, so building the same commit twice gives the same page
// (scripts/verify-live.mjs depends on that); it still changes whenever the snapshot is refreshed.
const start: Record<string, unknown> = {};
const choose = (src: string, n: number) => createHash('sha256').update(snaps + src).digest().readUInt32BE(0) % n;
for (const [src, n] of Object.entries(JSON.parse(snaps) as Record<string, number>)) {
	if (!n || !['nature', 'poems', 'featured', 'history', 'art', 'photos'].includes(src)) continue;
	try { start[src] = JSON.parse(readFileSync(`public/data/${src}-${choose(src, n)}.json`, 'utf8')); } catch {}
}
const startJSON = JSON.stringify(start).replace(/</g, '\\u003c');

const sources = [
	['art', 'art', 'public-domain paintings, prints and objects from the Art Institute of Chicago', 3],
	['nature', 'nature', 'the most-loved wildlife photos on iNaturalist, identified by people who know', 3],
	['featured', 'wikipedia: best of', 'featured articles, pictures of the day, "did you know" and on-this-day, from a random day since 2016', 3],
	['random', 'wikipedia: random', 'a truly random article. most are small. some are wonderful', 2],
	['poems', 'poems', 'off by default: short public-domain poems, mostly old English-language poets', 0],
	['photos', 'photos', 'featured pictures on Wikimedia Commons, voted the best of 100 million files', 3],
	['history', 'old photos', 'photographs from the Library of Congress, mostly 1860s–1960s', 2],
	['books', 'books', 'classic and well-loved books from Open Library, by subject', 2],
	['planet', 'the planet right now', 'earthquakes from the last day, live from the US Geological Survey', 1],
	['fedi', 'fediverse', 'off by default: posts people are boosting on mastodon.social right now, often tech and news chatter', 0],
	['films', 'old films', 'public-domain films from the Prelinger Archives: ads, newsreels, how-to films, 1910s–1970s. tap to play', 2],
	['met', 'the met', 'public-domain art and objects from the Metropolitan Museum of Art in New York: 5,000 years of it', 2],
	['gutenberg', 'free books', 'whole books you can read free on Project Gutenberg, from its 79,000', 2],
	['records', 'old records', '78rpm records from the 1900s–1950s, digitised by the Internet Archive. tap to play', 2],
	['cyber', 'security', 'cybersecurity: vulnerabilities attackers are really using (CISA), and how attacks work (MITRE ATT&CK, CAPEC)', 2],
	['today', 'today', "off by default: what the world is reading on Wikipedia right now, and today's news", 0],
	['design', 'design', 'textiles, posters, ceramics, jewellery and dress from the V&A in London', 2],
	['curious', 'curiosities', 'old medical, botanical and scientific images from the Wellcome Collection', 2],
	['europe', 'europe’s museums', 'open-licensed images from thousands of European museums, libraries and archives via Europeana', 2],
	['travel', 'travel', 'a random place in the world, from the Wikivoyage travel guide', 2],
	['amour', 'amour', 'off by default: love poems and the nude in art, from Cleveland museum and PoetryDB', 0],
	['hn', 'people talking', 'the best recent links on Hacker News, with their comment threads. off by default: mostly tech-industry talk', 0],
] as const;
---

<Base title="the feed · aishipped.lol" description="An endless scroll with no ads, no tracking and an algorithm you set yourself.">
	<script type="application/json" id="preconnect" set:html={JSON.stringify(["https://en.wikipedia.org", "https://upload.wikimedia.org", "https://api.inaturalist.org", "https://inaturalist-open-data.s3.amazonaws.com", "https://openaccess-api.clevelandart.org", "https://openaccess-cdn.clevelandart.org", "https://api.artic.edu", "https://www.artic.edu", "https://commons.wikimedia.org", "https://poetrydb.org", "https://archive.org", "https://www.loc.gov", "https://tile.loc.gov", "https://openlibrary.org", "https://covers.openlibrary.org", "https://images-api.nasa.gov", "https://images-assets.nasa.gov", "https://mastodon.social", "https://earthquake.usgs.gov"])} />
	<script type="application/json" id="snaps" set:html={snaps} />
	<script type="application/json" id="start" set:html={startJSON} />
	<div class="bar" id="bar">
		<a href="/" class="home">aishipped.lol</a>
		<span class="stat"><span id="clock">0 min</span> · <span id="count">0</span> cards</span>
		<span class="spacer"></span>
		<span class="order" role="group" aria-label="order">
			<button data-order="drawn" title="cards in the order they were picked">as drawn</button>
			<button data-order="az" title="each chapter sorted A to Z by title">A–Z</button>
			<button id="shuffleBtn" title="a new random seed: the same link always gives the same cards in the same order">shuffle</button>
		</span>
		<button id="tuneBtn" aria-expanded="false" aria-controls="tune">tune</button>
		<button id="savedBtn" aria-controls="saved">saved <span id="savedCount">0</span></button>
	</div>

	<main>
		<header class="hero">
			<p class="prompt">$ cat /feed</p>
			<h1>the feed<span class="cursor">_</span></h1>
			<p class="tag">an endless scroll that isn't farming you.</p>
			<ol class="rules">
				<li><b>you are the algorithm.</b> Press <em>tune</em>: each slider is how often a kind of card shows up, and <em>your taste</em> is a profile you write yourself. That is the whole ranking.</li>
				<li><b>every card tells you why it's here.</b> No hidden engagement score. Open <em>why am I seeing this?</em> on any card for the exact rule that picked it and put it where it is, and <em>delivery log</em> lets you download every one.</li>
				<li><b>any ranking runs on your computer.</b> Taste matching uses your own words, or a model on your own machine through Ollama. No server sees your profile.</li>
				<li><b>nothing is tracked.</b> This page has no analytics. Your weights and saves stay in this browser.</li>
				<li><b>everything is credited and linked.</b> All of it comes from museums, Wikipedia, NASA and people who share their work openly.</li>
				<li><b>it shows you the clock.</b> The time you've spent is at the top, and every chapter ends with a place to stop.</li>
			</ol>
			<p class="seedline" id="seedLine" hidden></p>
			<p class="keys">keys: <kbd>j</kbd>/<kbd>k</kbd> next/previous card · <kbd>s</kbd> save · <kbd>m</kbd> more like this</p>
		</header>

		<div id="stream"></div>
		<p id="sentinel">loading…</p>
	</main>

	<aside id="tune" class="panel" hidden>
		<h2>tune</h2>
		<label class="rawtoggle">
			<input type="checkbox" id="raw" />
			<span><b>uncurated</b>: every card is a random pick from a source's <em>whole</em> collection, not from anyone's selection
			(no featured lists, no most-voted, no trending, no museum highlights, no topic lists chosen by me). Sources that are
			nothing but someone's picks switch off. Expect it to be stranger and plainer: that is what an unedited archive looks like.</span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="packOnly" />
			<span><b>my pack</b>: only cards you've kept from your own pack on this computer, nothing else. It's built from
			collections you allow and judged by your own model (<code>npm run pack</code>), then reviewed by you
			(<code>npm run pack:serve</code>, keep or toss each card). <em id="packStatus"></em></span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="private" />
			<span><b>private</b>: the museums and libraries never see you. Cards come only from this site's own weekly copy,
			pictures are fetched for you by this site, and nothing contacts another server until you click a link. Fewer kinds
			of card (no live sources) and no "more like this".</span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="captions" />
			<span><b>captions</b>: show your pack's descriptions on every card. Off, a pack card is its picture and title; tap it for the rest.</span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="strict" checked />
			<span><b>strict</b>: a card with too little text to check against your never-show list (an untitled picture, say) is
			not shown. Everything downloaded ahead of time was also screened against the whole list, every field, before it got here.</span>
		</label>
		<p class="lede">How often each kind of card shows up. 0 turns it off.</p>
		{sources.map(([id, name, desc, w]) => (
			<label class="slider">
				<span class="name">{name} <output data-for={id}>{w}</output></span>
				<input type="range" min="0" max="5" step="1" value={w} data-src={id} data-default={w} />
				<span class="desc">{desc}</span>
			</label>
		))}
		<label class="slider">
			<span class="name">chapter length <output data-for="chapter">25</output></span>
			<input type="range" min="10" max="60" step="5" value="25" id="chapterLen" />
			<span class="desc">cards between each stopping point</span>
		</label>
		<label class="slider">
			<span class="name">never show</span>
			<textarea id="blocklist" rows="8" spellcheck="false"></textarea>
			<span class="desc">One word or phrase per line, lines starting with # are notes. Any card whose text mentions one is dropped before you see it, including "more like this". It reads text only: it can't see what is in a picture.</span>
		</label>
		<p class="row"><button id="resetBlock">restore default list</button></p>
		<h2 class="taste-h">your taste <small>runs on your computer</small></h2>
		<label class="slider">
			<span class="name">more of this</span>
			<textarea id="tasteWant" rows="4" spellcheck="false" placeholder="one thing per line, e.g.&#10;birds&#10;old jazz records&#10;japanese woodblock prints"></textarea>
		</label>
		<label class="slider">
			<span class="name">less of this</span>
			<textarea id="tasteLess" rows="3" spellcheck="false" placeholder="one thing per line. softer than never show: it lowers a card's score, it doesn't hide it"></textarea>
		</label>
		<label class="slider">
			<span class="name">taste strength <output data-for="tasteStrength">0</output></span>
			<input type="range" min="0" max="5" step="1" value="0" id="tasteStrength" />
			<span class="desc" id="tasteDesc">0 is off: pure random draw. Each step compares more of the cards waiting in a source and shows the one closest to your taste.</span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="tasteSaves" checked />
			<span><b>learn from my saves</b>: cards you've starred count as "more of this" too.</span>
		</label>
		<label class="rawtoggle">
			<input type="checkbox" id="tasteOllama" />
			<span><b>use the model on my computer</b>: match by meaning instead of exact words, with
			<input id="tasteModel" value="nomic-embed-text" size="16" spellcheck="false" /> through Ollama at localhost.
			One time: <code>ollama pull nomic-embed-text</code>, then let this site reach Ollama by setting
			<code>OLLAMA_ORIGINS=https://aishipped.lol</code> where Ollama starts: in its service settings if it runs in the
			background (on NixOS, <code>services.ollama.environmentVariables</code>), or as <code>OLLAMA_ORIGINS=https://aishipped.lol ollama serve</code> if you start it by hand.
			<em id="tasteStatus"></em></span>
		</label>
		<p class="row"><button id="tasteExport">download my profile</button> <button id="tasteImport">load a profile</button> <button id="logExport">download delivery log</button></p>
		<p class="desc">The delivery log is every card shown on this device: when, from where, the link, the image address, the reason and the taste score, plus every server this page has contacted. It is kept in this browser and downloaded as a file you can open and check.</p>
		<p class="lede audit">
			What decides the order: the buttons at the top. <em>as drawn</em> shows cards in the order they were picked; <em>A–Z</em> sorts each chapter by title;
			<em>shuffle</em> picks a seed number, shown above the feed, and the same link always gives the same cards in the same order. Which cards are picked is a random draw using the weights above, then, only if you turn taste strength up, a comparison
			against the profile you wrote, done in this browser or by your own computer's model. No server-side model, no profile anyone
			else holds, no history of what you clicked; the code is <a href="https://github.com/GuySittingInChair/aishipped/blob/main/src/pages/feed.astro">here</a>.
			Some sources hand over their own popular lists (wildlife and Hacker News by votes, Mastodon trends, Wikipedia's most read),
			ranked the same for everyone. Set those to 0 for a feed with no popularity in it at all.
		</p>
		<p class="row"><button id="forgetSeen">forget what I've seen</button> <button id="resetTune">reset</button> <button data-close>done</button></p>
		<p class="row"><button id="forgetAll" class="danger">forget everything on this device</button></p>
		<p class="desc">Deletes everything this site keeps in this browser: sliders, taste, saves, never-show list, what you've seen, the delivery log, the homepage checklist and the cached pictures.</p>
	</aside>

	<aside id="saved" class="panel" hidden>
		<h2>saved</h2>
		<p class="lede">Kept in this browser only.</p>
		<ul id="savedList"></ul>
		<p class="row"><button id="exportSaved">copy as text</button> <button data-close>done</button></p>
	</aside>
</Base>

<script>
	import BLOCK_TXT from '../data/blocklist.txt?raw';
	import { blockRegex } from '../data/block.mjs';
	type Card = {
		id: string;
		src: string;
		title: string;
		sub?: string;
		body?: string;
		verse?: boolean;
		img?: string;
		imgAlt?: string;
		placeholder?: string;
		link: string;
		linkText?: string;
		extra?: [string, string];
		credit?: string;
		draw?: (c: HTMLCanvasElement) => void;
		embed?: string;
		batch?: string; // which fetch it came from, for the why note
		more?: () => Promise<Card[]>;
	};

	const W_KEY = 'aishipped.feed.weights';
	const S_KEY = 'aishipped.feed.saved';
	const load = <T,>(k: string, d: T): T => {
		try { return JSON.parse(localStorage.getItem(k) || '') ?? d; } catch { return d; }
	};
	const store = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };

	// phones get smaller images: same look, a fraction of the bytes
	const small = innerWidth * devicePixelRatio < 1100;
	// ---- seed and modes -------------------------------------------------------
	// With ?seed=N every random choice comes from that number instead of Math.random, cards come only from this
	// site's own weekly copy (live sources change minute to minute), one at a time so network timing can't
	// change the order, and "already seen" is ignored. Same seed + same build + same sliders and never-show
	// list = the same cards in the same order, on any device.
	const params = new URLSearchParams(location.search);
	const SEED = /^\d{1,9}$/.test(params.get('seed') ?? '') ? +params.get('seed')! : null;
	const mulberry = (a: number) => () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
	const rnd = SEED === null ? Math.random : mulberry(SEED);
	const ORDER_KEY = 'aishipped.feed.order', PRIV_KEY = 'aishipped.feed.private';
	type Order = 'drawn' | 'az' | 'shuffle';
	const okOrder = (x: unknown): x is Order => x === 'drawn' || x === 'az' || x === 'shuffle';
	const order: Order = okOrder(params.get('order')) && !(params.get('order') === 'shuffle' && SEED === null) ? params.get('order') as Order : SEED !== null ? 'shuffle' : (() => { const o = load<string>(ORDER_KEY, 'drawn'); return o === 'az' ? 'az' : 'drawn'; })();
	const privateMode = load<boolean>(PRIV_KEY, false);
	const fixedData = SEED !== null || privateMode; // only this site's own saved copies
	const FIXED_SRC = new Set(['nature', 'featured', 'history', 'art', 'photos', 'books', 'design', 'curious', 'europe', 'gutenberg', 'poems', 'cyber', 'random', 'travel']);
	const unseen = (id: string) => SEED !== null || !seen.has(id);
	// private mode: pictures come through this site (api/img.js), so the museum sees this site, not you
	const pic = (u?: string) => (u && privateMode && /^https:\/\//.test(u) ? `/api/img?u=${encodeURIComponent(u)}` : u);
	if (!privateMode) for (const h of JSON.parse(document.getElementById('preconnect')?.textContent || '[]')) {
		const l = document.createElement('link'); l.rel = 'preconnect'; l.href = h; l.crossOrigin = ''; document.head.append(l);
	}
	const rand = (n: number) => Math.floor(rnd() * n);
	const pick = <T,>(a: T[]) => a[rand(a.length)];
	const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = rand(i + 1); [a[i], a[j]] = [a[j], a[i]]; } return a; };
	const getJSON = async (url: string, ms = 20000) => {
		const r = await fetch(url, { signal: AbortSignal.timeout(ms) });
		if (!r.ok) throw new Error(`${r.status} ${url}`);
		return r.json();
	};
	// slow sources go through our CDN cache first, then straight to the source if that fails
	// fastest first: a build-time snapshot on the CDN, then the cached relay, then the source itself
	const snaps: Promise<Record<string, number>> = Promise.resolve(JSON.parse(document.getElementById('snaps')?.textContent || '{}'));
	const start: Record<string, any> = JSON.parse(document.getElementById('start')?.textContent || '{}');
	const snapshot = async (s: string) => {
		if (start[s] && !rawBox.checked) { const d = start[s]; delete start[s]; return d; }
		const n = (await snaps)[s];
		if (!n) throw new Error('no snapshot');
		return getJSON(`/data/${s}-${rand(n)}.json`, 4000);
	};
	const relay = (s: string, pages: number, direct: string) => fixedData ? snapshot(s) :
		snapshot(s)
			.catch(() => getJSON(`/api/src?s=${s}&p=${rand(pages)}`, 5000))
			.catch(() => getJSON(direct));
	const text = (html: string) => new DOMParser().parseFromString(html, 'text/html').body.textContent?.trim() ?? '';
	const qs = (o: Record<string, string | number>) => new URLSearchParams(Object.entries(o).map(([k, v]) => [k, String(v)])).toString();

	// ---- never show -----------------------------------------------------------

	const B_KEY = 'aishipped.feed.block';
	const DEFAULT_BLOCK = BLOCK_TXT.trim();
	let blockRe: RegExp | null = null;
	function setBlock(list: string) { blockRe = blockRegex(list); }
	// strict: if a card has too little text to check against the list, don't show it at all
	const ST_KEY = 'aishipped.feed.strict';
	const strictBox = document.getElementById('strict') as HTMLInputElement;
	strictBox.checked = load<boolean>(ST_KEY, true);
	const checkable = (c: Card) => [c.title, c.sub, c.body, c.imgAlt].filter(Boolean).join(' ').length >= 25;
	const blocked = (c: Card) => (strictBox.checked && !checkable(c))
		|| (!!blockRe && blockRe.test([c.title, c.sub, c.body, c.imgAlt, c.credit, c.extra?.[1]].filter(Boolean).join(' \n ')));

	// ---- sources ------------------------------------------------------------

	const AIC = 'https://api.artic.edu/api/v1/artworks/search';
	const AIC_FIELDS = 'id,title,image_id,artist_display,artist_id,date_display,medium_display,thumbnail';
	function artCard(a: any): Card | null {
		if (!a.image_id) return null;
		return {
			id: `art:${a.id}`,
			src: 'art',
			title: a.title,
			sub: [a.artist_display?.split('\n')[0], a.date_display].filter(Boolean).join(' · '),
			body: a.medium_display,
			img: `https://www.artic.edu/iiif/2/${a.image_id}/full/${small ? 600 : 843},/0/default.jpg`,
			imgAlt: a.thumbnail?.alt_text || a.title,
			placeholder: a.thumbnail?.lqip,
			link: `https://www.artic.edu/artworks/${a.id}`,
			linkText: 'artic.edu',
			credit: 'Art Institute of Chicago · public domain',
			more: a.artist_id ? async () => {
				const d = await getJSON(`${AIC}?query[bool][must][0][term][artist_id]=${a.artist_id}&query[bool][must][1][term][is_public_domain]=true&limit=12&fields=${AIC_FIELDS}`);
				return shuffle(d.data.map(artCard).filter(Boolean)).slice(0, 3);
			} : undefined,
		};
	}
	const CMA = 'https://openaccess-api.clevelandart.org/api/artworks/';
	function cmaCard(a: any): Card | null {
		const img = a.images?.web?.url;
		if (!img) return null;
		const who = a.creators?.[0];
		return {
			id: `cma:${a.id}`,
			src: 'art',
			title: a.title,
			sub: [who?.description, a.creation_date].filter(Boolean).join(' · '),
			body: [a.technique, a.wall_description || a.description || a.fun_fact].filter(Boolean).map(text).join('\n'),
			img,
			imgAlt: a.title,
			link: a.url,
			linkText: 'clevelandart.org',
			credit: 'Cleveland Museum of Art · CC0',
			more: who?.id ? async () => {
				const d = await getJSON(`${CMA}?${qs({ cc0: 1, has_image: 1, limit: 12, artists: who.description.split(' (')[0] })}`);
				return shuffle(d.data.filter((x: any) => x.id !== a.id).map(cmaCard).filter(Boolean)).slice(0, 3);
			} : undefined,
		};
	}
	const cma = async () => shuffle((await relay('art', 2050, `${CMA}?${qs({ cc0: 1, has_image: 1, limit: 20, skip: rand(41000) })}`)).data.map(cmaCard).filter(Boolean));
	const aic = async () => shuffle((await getJSON(`${AIC}?query[term][is_public_domain]=true&limit=20&page=${1 + rand(490)}&fields=${AIC_FIELDS}`)).data.map(artCard).filter(Boolean));
	// two museums; if one refuses, the other covers
	const art = () => (fixedData || rnd() < 0.5 ? cma() : aic()).catch(() => cma()).catch(() => aic());

	const INAT = 'https://api.inaturalist.org/v1/observations';
	function natureCard(o: any): Card | null {
		const photo = o.photos?.[0];
		if (!photo || !o.taxon) return null;
		const t = o.taxon;
		return {
			id: `nature:${o.id}`,
			src: 'nature',
			title: t.preferred_common_name ? t.preferred_common_name[0].toUpperCase() + t.preferred_common_name.slice(1) : t.name,
			sub: [t.preferred_common_name ? t.name : '', o.place_guess, o.observed_on].filter(Boolean).join(' · '),
			img: photo.url.replace('/square.', small ? '/medium.' : '/large.'),
			imgAlt: t.preferred_common_name || t.name,
			link: o.uri,
			linkText: 'inaturalist.org',
			extra: t.wikipedia_url ? [t.wikipedia_url.replace('http:', 'https:'), 'wikipedia'] : undefined,
			credit: photo.attribution,
			more: async () => {
				const d = await getJSON(`${INAT}?${qs({ taxon_id: t.id, photos: 'true', quality_grade: 'research', order_by: 'votes', per_page: 12 })}`);
				return shuffle(d.results.filter((x: any) => x.id !== o.id).map(natureCard).filter(Boolean)).slice(0, 3);
			},
		};
	}
	async function nature() {
		const d = await relay('nature', 190, `${INAT}?${qs({ quality_grade: 'research', photos: 'true', order_by: 'votes', per_page: 50, page: 1 + rand(190) })}`);
		return shuffle(d.results.map(natureCard).filter(Boolean));
	}

	// sister wikis share the same API; travel cards come from Wikivoyage
	const VOYAGE = 'https://en.wikivoyage.org';
	function wikiCard(p: any, src: string, host = 'https://en.wikipedia.org'): Card {
		const site = host === VOYAGE ? 'wikivoyage' : 'wikipedia';
		return {
			id: `${site}:${p.pageid ?? p.title}`,
			src,
			title: p.title,
			sub: p.description,
			body: p.extract,
			img: p.thumbnail?.source,
			imgAlt: p.title,
			link: `${host}/wiki/${encodeURIComponent(p.title.replace(/ /g, '_'))}`,
			linkText: site,
			credit: `${site[0].toUpperCase() + site.slice(1)} · CC BY-SA`,
			more: () => wikiQuery({ generator: 'search', gsrsearch: `morelike:${p.title}`, gsrlimit: 4 }, src, host).then((c) => c.slice(0, 3)),
		};
	}
	const wikiURL = (params: Record<string, string | number>, host: string) => `${host}/w/api.php?${qs({
		action: 'query', format: 'json', origin: '*', prop: 'extracts|pageimages|description',
		exintro: 1, explaintext: 1, exlimit: 20, pithumbsize: small ? 500 : 800, ...params,
	})}`;
	async function wikiQuery(params: Record<string, string | number>, src: string, host = 'https://en.wikipedia.org', snap?: string) {
		const d = snap ? await relay(snap, 60, wikiURL(params, host)) : await getJSON(wikiURL(params, host));
		return Object.values(d.query?.pages ?? {})
			.sort((a: any, b: any) => (a.index ?? 0) - (b.index ?? 0))
			.map((p: any) => wikiCard(p, src, host));
	}
	async function travel() {
		const cards = await wikiQuery({ generator: 'random', grnnamespace: 0, grnlimit: 30 }, 'travel', VOYAGE, 'travel');
		return cards.filter((c) => c.img && (c.body?.length ?? 0) > 150);
	}
	async function random() {
		const cards = await wikiQuery({ generator: 'random', grnnamespace: 0, grnlimit: 20 }, 'random', undefined, 'random');
		return cards.filter((c) => (c.body?.length ?? 0) > 250);
	}

	async function featured() {
		const start = Date.UTC(2016, 0, 1);
		const p = rand(Math.min(3900, Math.floor((Date.now() - start) / 864e5) - 1));
		const direct = `https://en.wikipedia.org/api/rest_v1/feed/featured/${new Date(start + p * 864e5).toISOString().slice(0, 10).replace(/-/g, '/')}`;
		const d = await relay('featured', 3900, direct);
		const day = new Date(d.date ?? start + p * 864e5);
		const out: Card[] = [];
		const nice = day.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
		if (d.tfa) {
			const c = wikiCard({ title: d.tfa.titles?.normalized ?? d.tfa.title, description: d.tfa.description, extract: d.tfa.extract, thumbnail: d.tfa.thumbnail, pageid: d.tfa.pageid }, 'featured');
			c.sub = `featured article, ${nice}` + (d.tfa.description ? ` · ${d.tfa.description}` : '');
			out.push(c);
		}
		if (d.image?.thumbnail) {
			out.push({
				id: `potd:${d.image.title}`,
				src: 'featured',
				title: d.image.description?.text ? text(d.image.description.html ?? d.image.description.text).slice(0, 160) : d.image.title.replace(/^File:/, ''),
				sub: `picture of the day, ${nice}`,
				img: d.image.thumbnail.source,
				imgAlt: d.image.description?.text ?? '',
				link: d.image.file_page,
				linkText: 'wikimedia commons',
				credit: [d.image.artist?.text, d.image.license?.type].filter(Boolean).join(' · '),
			});
		}
		for (const e of shuffle(d.onthisday ?? []).slice(0, 3)) {
			const p = e.pages?.[0];
			out.push({
				id: `otd:${e.year}:${e.text.slice(0, 40)}`,
				src: 'featured',
				title: String(e.year),
				sub: `on this day: ${day.toLocaleDateString('en', { month: 'long', day: 'numeric', timeZone: 'UTC' })}`,
				body: e.text,
				img: p?.thumbnail?.source,
				imgAlt: p?.title,
				link: p ? p.content_urls?.desktop?.page ?? `https://en.wikipedia.org/wiki/${p.title}` : 'https://en.wikipedia.org/wiki/Wikipedia:On_this_day',
				linkText: 'wikipedia',
				more: p ? () => wikiQuery({ titles: e.pages.slice(0, 3).map((x: any) => x.titles?.normalized ?? x.title).join('|') }, 'featured') : undefined,
			});
		}
		for (const y of shuffle(d.dyk ?? []).slice(0, 3)) {
			const doc = new DOMParser().parseFromString(y.html, 'text/html');
			const a = doc.querySelector('b a, a');
			const title = a?.getAttribute('title');
			out.push({
				id: `dyk:${y.text.slice(0, 50)}`,
				src: 'featured',
				title: 'did you know…',
				body: '…' + text(y.html).replace(/^\.\.\.\s*/, ' '),
				link: title ? `https://en.wikipedia.org/wiki/${encodeURIComponent(title.replace(/ /g, '_'))}` : 'https://en.wikipedia.org/wiki/Wikipedia:Did_you_know',
				linkText: 'wikipedia',
				more: title ? () => wikiQuery({ titles: title }, 'featured') : undefined,
			});
		}
		return shuffle(out);
	}

