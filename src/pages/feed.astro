	const EU_Q = ['painting', 'map', 'manuscript', 'poster', 'photograph', 'costume', 'botanical', 'castle', 'portrait', 'landscape', 'folk art', 'jewellery', 'bird', 'bicycle', 'calligraphy', 'mosaic', 'music instrument', 'sculpture', 'fashion', 'textile', 'window'];
	const first = (x: unknown) => (Array.isArray(x) ? x[0] : x) as string | undefined;
	function europeCard(i: any): Card | null {
		const preview = first(i.edmPreview);
		if (!preview) return null;
		const title = (first(i.title) ?? '').split(',').slice(0, 4).join(',').slice(0, 140) || 'untitled';
		return {
			id: `eu:${i.id}`,
			src: 'europe',
			title,
			sub: [first(i.dcCreator), first(i.year), first(i.country)].filter(Boolean).join(' · '),
			img: `${preview}&size=w400`,
			imgAlt: title,
			link: (i.guid ?? `https://www.europeana.eu/item${i.id}`).split('?')[0],
			linkText: 'europeana.eu',
			credit: [first(i.dataProvider), /zero|publicdomain|mark/.test(first(i.rights) ?? '') ? 'public domain' : 'open licence'].filter(Boolean).join(' · '),
			more: async () => {
				const who = first(i.dcCreator)?.split(',').slice(0, 2).join(',');
				const query = who ? `who:"${who.replace(/"/g, '')}"` : `DATA_PROVIDER:"${(first(i.dataProvider) ?? '').replace(/"/g, '')}"`;
				const d = await getJSON(`https://api.europeana.eu/record/v2/search.json?${qs({ query, wskey: 'api2demo', rows: 20, media: 'true', reusability: 'open', qf: 'TYPE:IMAGE' })}`);
				return shuffle((d.items ?? []).filter((x: any) => x.id !== i.id).map(europeCard).filter(Boolean)).slice(0, 3);
			},
		};
	}
	async function europe() {
		const d = await relay('europe', EU_Q.length * 4, `https://api.europeana.eu/record/v2/search.json?${qs({ query: pick(EU_Q), wskey: 'api2demo', rows: 24, start: 1 + rand(400), media: 'true', reusability: 'open', qf: 'TYPE:IMAGE' })}`);
		return shuffle((d.items ?? []).map(europeCard).filter(Boolean));
	}

	let hnIds: number[] = [];
	async function hn() {
		// one cached request for 25 stories; straight to HN (one request per story) only if that fails
		const items: any[] = await getJSON(`/api/src?s=hn&p=${rand(8)}`, 5000).catch(async () => {
			if (!hnIds.length) hnIds = shuffle(await getJSON('https://hacker-news.firebaseio.com/v0/beststories.json'));
			return Promise.all(hnIds.splice(0, 6).map((id) => getJSON(`https://hacker-news.firebaseio.com/v0/item/${id}.json`)));
		});
		return items.filter((i) => i && !i.dead && !i.deleted).map((i): Card => {
			const thread = `https://news.ycombinator.com/item?id=${i.id}`;
			let host = '';
