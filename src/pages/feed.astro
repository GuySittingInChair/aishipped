			credit: 'Internet Archive · public domain',
			more: subject ? async () => {
				const d = await getJSON(`https://archive.org/advancedsearch.php?${qs({
					q: `collection:prelinger AND mediatype:movies AND subject:"${subject.replace(/"/g, '')}"`, 'fl[]': 'identifier', rows: 20, output: 'json', 'sort[]': 'downloads desc',
				})}&fl[]=title&fl[]=year&fl[]=description&fl[]=subject`);
				return shuffle(d.response.docs.filter((x: any) => x.identifier !== f.identifier).map(filmCard).filter(Boolean)).slice(0, 3);
			} : undefined,
		};
	}

	async function today() {
		const now = new Date(Date.now() - 864e5);
		const d = await getJSON(`https://en.wikipedia.org/api/rest_v1/feed/featured/${now.toISOString().slice(0, 10).replace(/-/g, '/')}`);
		const read = (d.mostread?.articles ?? []).filter((a: any) => !/^(Main_Page|Special:|Wikipedia:)/.test(a.title)).slice(0, 25).map((a: any, i: number): Card => {
			const c = wikiCard({ title: a.titles?.normalized ?? a.title, description: a.description, extract: a.extract, thumbnail: a.thumbnail, pageid: a.pageid }, 'today');
			c.sub = `#${i + 1} most read yesterday · ${a.views.toLocaleString()} views` + (a.description ? ` · ${a.description}` : '');
			return c;
		});
		const news = (d.news ?? []).map((n: any): Card => {
			const p = n.links?.[0];
			return {
				id: `news:${n.story.slice(0, 50)}`,
				src: 'today',
				title: 'in the news',
				body: text(n.story),
				img: p?.thumbnail?.source,
				imgAlt: p?.titles?.normalized,
				link: p?.content_urls?.desktop?.page ?? 'https://en.wikipedia.org/wiki/Portal:Current_events',
				linkText: 'wikipedia',
			};
		});
		return shuffle([...read, ...news]);
	}

