		},
		gutenberg: async () => shuffle(((await getJSON(`https://gutendex.com/books/?page=${1 + rand(2400)}`, 45000)).results ?? []).map(gutenbergCard).filter(Boolean)),
		// archive search stops paging at 10,000 results, so pick a random year first
		records: async () => {
			const y = 1898 + rand(62);
			const d = await getJSON(`https://archive.org/advancedsearch.php?${qs({ q: `collection:georgeblood AND year:${y}`, 'fl[]': 'identifier', rows: 25, page: 1 + rand(40), output: 'json' })}${REC_FL}`);
			return shuffle(d.response.docs.map(recordCard).filter(Boolean));
		},
		films: async () => {
			const d = await getJSON(`https://archive.org/advancedsearch.php?${qs({ q: 'collection:prelinger AND mediatype:movies', 'fl[]': 'identifier', rows: 20, page: 1 + rand(500), output: 'json' })}&fl[]=title&fl[]=year&fl[]=description&fl[]=subject`);
			return shuffle(d.response.docs.map(filmCard).filter(Boolean));
		},
		poems: async () => (await getJSON('https://poetrydb.org/random/20/title,author,lines,linecount')).filter(short).map(poemCard),
		random: async () => (await wikiQuery({ generator: 'random', grnnamespace: 0, grnlimit: 20 }, 'random')).filter((c) => (c.body?.length ?? 0) > 250),
	};
	// with "my pack" on, nothing but the pack: no other source is even asked
	const packOn = () => packBox.checked && !fixedData;
	const enabled = (id: string) => (packOn() ? id === 'pack' : !(isRaw() && RAW[id] === null) && (!fixedData || FIXED_SRC.has(id)));
	rawBox.addEventListener('change', () => {
		store(R_KEY, rawBox.checked);
		for (const [id, x] of Object.entries(SOURCES)) { x.queue = []; x.fails = 0; if (enabled(id) && weights()[id] > 0) refill(id); }
		document.getElementById('tune')!.classList.toggle('raw', rawBox.checked);
	});

	const fills: Record<string, () => Promise<Card[]>> = { art, nature, featured, random, space, poems, hn, amour, design, curious, europe, travel, films, today, nasa, photos, met, gutenberg, records, cyber, history, books, planet, fedi };
	for (const input of document.querySelectorAll<HTMLInputElement>('#tune input[data-src]')) {
		const id = input.dataset.src!;
		SOURCES[id] = { name: input.closest('label')!.querySelector('.name')!.firstChild!.textContent!.trim(), fill: fills[id], queue: [], fails: 0 };
	}

	// ---- your pack (served from this computer by scripts/pack/serve.mjs) ------------
	const PACK = 'http://127.0.0.1:8790';
	const PK_KEY = 'aishipped.feed.pack', CAP_KEY = 'aishipped.feed.captions';
	const packBox = document.getElementById('packOnly') as HTMLInputElement;
	const capBox = document.getElementById('captions') as HTMLInputElement;
	const packStatus = document.getElementById('packStatus')!;
	packBox.checked = load<boolean>(PK_KEY, false);
	capBox.checked = load<boolean>(CAP_KEY, false);
	SOURCES.pack = {
		name: 'your pack',
		fill: async () => {
			try {
				const r = await fetch(`${PACK}/api/cards?status=kept`, { signal: AbortSignal.timeout(5000) });
				const got: any[] = await r.json();
				packStatus.textContent = ` ${got.length} kept cards on this computer.`;
				const fresh = got.filter((c) => !seen.has(`pack:${c.id}`));
				if (!fresh.length) throw new Error(got.length ? 'all seen' : 'empty');
				return shuffle(fresh.map((c): Card => ({ ...c, id: `pack:${c.id}`, src: 'pack', credit: [c.credit, c.from].filter(Boolean).join(' · ') })));
			} catch (e) {
				const why = (e as Error).message;
				packStatus.textContent = why === 'all seen' ? ' You have seen every card you kept: build more, or press "forget what I\'ve seen".'
					: why === 'empty' ? ' Your pack has no kept cards yet: review some at 127.0.0.1:8790.'
					: ' Not reachable: run npm run pack:serve in the aishipped folder.';
				throw e;
			}
		},
		queue: [], fails: 0,
	};
	packBox.addEventListener('change', () => { store(PK_KEY, packBox.checked); location.reload(); });
	capBox.addEventListener('change', () => {
		store(CAP_KEY, capBox.checked);
		for (const a of stream.querySelectorAll<HTMLElement>('.card.src-pack')) a.classList.toggle('quiet', !capBox.checked);
	});

	function refill(id: string) {
		const s = SOURCES[id];
		const fill = isRaw() && RAW[id] ? RAW[id]! : s.fill;
		s.pending ??= fill()
			.then((cards) => {
				const b = s.batches = (s.batches ?? 0) + 1;
				cards.forEach((c, k) => { c.batch ??= `card ${k + 1} of ${cards.length} in batch ${b} from ${s.name}`; });
				s.queue.push(...cards.filter((c) => unseen(c.id) && !blocked(c))); s.fails = 0;
			})
			.catch(() => { s.fails++; })
			.finally(() => { s.pending = undefined; });
		return s.pending;
	}

	// ---- weights ------------------------------------------------------------

	const sliders = [...document.querySelectorAll<HTMLInputElement>('#tune input[data-src]')];
	const chapterInput = document.getElementById('chapterLen') as HTMLInputElement;
	// v2: news, fediverse and poems off, and the feed served from this site's own screened copies, even for
	// browsers that saved settings before those became the defaults. Runs once; later tuning is kept.
	const V_KEY = 'aishipped.feed.v';
	if (load<number>(V_KEY, 0) < 2) {
		const w = load<Record<string, number>>(W_KEY, {});
		if (Object.keys(w).length) store(W_KEY, { ...w, poems: 0, today: 0, fedi: 0 });
		store(R_KEY, false); rawBox.checked = false;
		store(V_KEY, 2);
	}
	const savedWeights = load<Record<string, number>>(W_KEY, {});
	for (const s of sliders) if (savedWeights[s.dataset.src!] != null) s.value = String(savedWeights[s.dataset.src!]);
	if (savedWeights.chapter) chapterInput.value = String(savedWeights.chapter);
	const weights = () => Object.fromEntries(sliders.map((s) => [s.dataset.src!, +s.value]));
	function syncOutputs() {
		for (const s of [...sliders, chapterInput]) {
			document.querySelector(`output[data-for="${s.dataset.src ?? 'chapter'}"]`)!.textContent = s.value;
		}
	}
	function saveWeights() { store(W_KEY, { ...weights(), chapter: +chapterInput.value }); syncOutputs(); }
	for (const s of [...sliders, chapterInput]) s.addEventListener('input', saveWeights);
	const blockBox = document.getElementById('blocklist') as HTMLTextAreaElement;
	blockBox.value = load<string>(B_KEY, DEFAULT_BLOCK);
	// an edited list still picks up every term added to the default later (not ones the person deleted:
	// only terms that are new since the default this browser last saw get added)
	{
		const BD_KEY = 'aishipped.feed.blockDefault';
		const lines = (t: string) => t.split('\n').map((x) => x.trim().toLowerCase()).filter(Boolean);
		const before = new Set(lines(load<string>(BD_KEY, '')));
		const have = new Set(lines(blockBox.value));
		const add = lines(DEFAULT_BLOCK).filter((t) => !t.startsWith('#') && !have.has(t) && !before.has(t));
		if (add.length) blockBox.value += '\n# added since you last visited\n' + add.join('\n');
		store(BD_KEY, DEFAULT_BLOCK);
	}
	setBlock(blockBox.value);
	strictBox.addEventListener('change', () => { store(ST_KEY, strictBox.checked); applyBlock(); });
	const applyBlock = () => {
		store(B_KEY, blockBox.value);
		setBlock(blockBox.value);
		// drop anything already on screen or queued that now matches
		for (const s of Object.values(SOURCES)) s.queue = s.queue.filter((c) => !blocked(c));
		for (const el of stream.querySelectorAll<HTMLElement>('.card')) if (el.dataset.blockText && blockRe?.test(el.dataset.blockText)) el.remove();
	};
	blockBox.addEventListener('change', applyBlock);
	document.getElementById('resetBlock')!.addEventListener('click', () => { blockBox.value = DEFAULT_BLOCK; applyBlock(); });
	document.getElementById('forgetSeen')!.addEventListener('click', (e) => {
		seen.clear(); remember();
		(e.target as HTMLButtonElement).textContent = 'forgotten';
	});
	document.getElementById('resetTune')!.addEventListener('click', () => {
		for (const s of sliders) s.value = s.dataset.default!;
		chapterInput.value = '25';
