	// default order is most-downloaded, so the first pages are the well-loved ones
	const gutenberg = async () => shuffle(((await relay('gutenberg', 40, `https://gutendex.com/books/?page=${1 + rand(40)}`)).results ?? []).map(gutenbergCard).filter(Boolean));

